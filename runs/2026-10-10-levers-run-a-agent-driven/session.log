{"arguments":"{\"path\": \"linkcheck.py\"}","id":"call_bc92b95c51e24f5f835ea073","kind":"tool_call","name":"read","outcome":"ran","request":4044,"seq":4264,"shown":"\"\"\"Check local file links and #anchors in Markdown files under a directory.\"\"\"\n\nimport os\nimport re\nimport sys\n\nLINK_RE = re.compile(r\"\\[[^\\]]*\\]\\(([^)]+)\\)\")\nSCHEME_RE = re.compile(r\"^[A-Za-z][A-Za-z0-9+.-]*:\")\nHEADING_RE = re.compile(r\"^#{1,6}\\s+(.*\\S)\\s*$\")\nFENCE_RE = re.compile(r\"^ {0,3}(`{3,}|~{3,})\")\n\n\ndef _closing_fence(line, fence):\n    \"\"\"True if line closes the fence opened by `fence` (same char, at least as long).\"\"\"\n    m = FENCE_RE.match(line)\n    return bool(m) and m.group(1)[0] == fence[0] and len(m.group(1)) >= len(fence) and line[m.end():].strip() == \"\"\n\n\ndef slugify(text):\n    \"\"\"GitHub-style heading slug: links become text, lowercase, spaces to hyphens.\"\"\"\n    text = re.sub(r\"\\[([^\\]]*)\\]\\([^)]*\\)\", r\"\\1\", text)\n    text = re.sub(r\"[^\\w\\s-]\", \"\", text).lower()\n    return re.sub(r\"\\s+\", \"-\", text.strip())\n\n\ndef anchors_of(path):\n    \"\"\"Yield the GitHub-style slug of each heading in path (a, a-1, ...).\n\n    Headings inside fenced code blocks are ignored.\n    \"\"\"\n    counts = {}\n    fence = None\n    with open(path, encoding=\"utf-8\") as f:\n        for line in f:\n            if fence:\n                if _closing_fence(line, fence):\n                    fence = None\n                continue\n            m = FENCE_RE.match(line)\n            if m:\n                fence = m.group(1)\n                continue\n            m = HEADING_RE.match(line)\n            if not m:\n                continue\n            slug = slugify(m.group(1))\n            n = counts.get(slug, 0)\n            counts[slug] = n + 1\n            yield slug if n == 0 else f\"{slug}-{n}\"\n\n\ndef local_target(raw):\n    \"\"\"Return (path, anchor) for a local link target, or None if not local (empty path = same file).\"\"\"\n    target = raw.strip()\n    if target.startswith(\"<\") and target.endswith(\">\"):\n        target = target[1:-1].strip()\n    if SCHEME_RE.match(target):\n        return None\n    parts = target.split(None, 1)\n    if len(parts) == 2 and parts[1].startswith('\"'):\n        target = parts[0]\n    path, _, anchor = target.partition(\"#\")\n    return path, anchor\n\n\ndef check_file(path):\n    \"\"\"Yield (line_number, target) for broken local links in path.\"\"\"\n    folder = os.path.dirname(path)\n    with open(path, encoding=\"utf-8\") as f:\n        for lineno, line in enumerate(f, 1):\n            for raw in LINK_RE.findall(line):\n                target = local_target(raw)\n                if target is None:\n                    continue\n                file_part, anchor = target\n                full = path if not file_part else os.path.join(folder, file_part)\n                if not os.path.exists(full):\n                    yield lineno, raw.strip()\n                elif anchor and anchor not in set(anchors_of(full)):\n                    yield lineno, raw.strip()\n\n\ndef main(argv):\n    args = [a for a in argv[1:] if a != \"--quiet\"]\n    quiet = len(args) != len(argv) - 1\n    directory = args[0] if args else \".\"\n    broken = 0\n    for root, _dirs, files in os.walk(directory):\n        for name in sorted(files):\n            if not name.endswith(\".md\"):\n                continue\n            path = os.path.join(root, name)\n            for lineno, target in check_file(path):\n                if not quiet:\n                    print(f\"{path}:{lineno}: {target}\")\n                broken += 1\n    return 1 if broken else 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv))","t":418630,"turn":6}
