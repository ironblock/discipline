{"kind":"delta","request":8827,"seq":8852,"t":607428,"tool_call":{"arguments":"{\"content\": \"export interface FrameInput {\\n    forward: number;\\n    strafe: number;\\n    sprint: boolean;\\n    jump: boolean;\\n    lookDX: number;\\n    lookDY: number;\\n    fire: boolean;\\n    reload: boolean;\\n    locked: boolean;\\n}\\n\\n/** Attach pointer-lock + keyboard controls to the canvas. Returns the frame input state. */\\nexport function attachControls(canvas: HTMLCanvasElement): FrameInput {\\n    const input: FrameInput = {\\n        forward: 0,\\n        strafe: 0,\\n        sprint: false,\\n        jump: false,\\n        lookDX: 0,\\n        lookDY: 0,\\n        fire: false,\\n        reload: false,\\n        locked: false,\\n    };\\n    const keys = new Set<string>();\\n    let fireHeld = false;\\n\\n    function refresh(): void {\\n        input.forward =\\n            (keys.has(\\\"KeyW\\\") || keys.has(\\\"ArrowUp\\\") ? 1 : 0) - (keys.has(\\\"KeyS\\\") || keys.has(\\\"ArrowDown\\\") ? 1 : 0);\\n        input.strafe =\\n            (keys.has(\\\"KeyD\\\") || keys.has(\\\"ArrowRight\\\") ? 1 : 0) - (keys.has(\\\"KeyA\\\") || keys.has(\\\"ArrowLeft\\\") ? 1 : 0);\\n        input.sprint = keys.has(\\\"ShiftLeft\\\") || keys.has(\\\"ShiftRight\\\");\\n        input.jump = keys.has(\\\"Space\\\");\\n        input.fire = fireHeld && input.locked;\\n    }\\n\\n    const onPointerDown = (e: PointerEvent): void => {\\n        if (e.button === 0) {\\n            fireHeld = true;\\n            refresh();\\n        }\\n        if (!input.locked) canvas.requestPointerLock();\\n    };\\n    const onPointerUp = (e: PointerEvent): void => {\\n        if (e.button === 0) {\\n            fireHeld = false;\\n            refresh();\\n        }\\n    };\\n    const onPointerMove = (e: PointerEvent): void => {\\n        if (!input.locked) return;\\n        input.lookDX += e.movementX;\\n        input.lookDY += e.movementY;\\n    };\\n    const onLockChange = (): void => {\\n        input.locked = document.pointerLockElement === canvas;\\n        if (!input.locked) {\\n            keys.clear();\\n            fireHeld = false;\\n        }\\n        refresh();\\n    };\\n    const onKeyDown = (e: KeyboardEvent): void => {\\n        keys.add(e.code);\\n        if (e.code === \\\"KeyR\\\") input.reload = true;\\n        refresh();\\n    };\\n    const onKeyUp = (e: KeyboardEvent): void => {\\n        keys.delete(e.code);\\n        refresh();\\n    };\\n    const onContext = (e: Event): void => e.preventDefault();\\n\\n    canvas.addEventListener(\\\"pointerdown\\\", onPointerDown);\\n    window.addEventListener(\\\"pointerup\\\", onPointerUp);\\n    window.addEventListener(\\\"pointermove\\\", onPointerMove);\\n    document.addEventListener(\\\"pointerlockchange\\\", onLockChange);\\n    window.addEventListener(\\\"keydown\\\", onKeyDown);\\n    window.addEventListener(\\\"keyup\\\", onKeyUp);\\n    canvas.addEventListener(\\\"contextmenu\\\", onContext);\\n\\n    return input;\\n}\", \"path\": \"/scratch/run3/babylon-lite-minecraft-fps/src/controls.ts\"}","id":"call_b784723bab0543ec8e576f9f","index":1,"name":"write"}}
