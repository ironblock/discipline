{"kind":"delta","request":8813,"seq":8822,"t":596205,"tool_call":{"arguments":"{\"content\": \"import type { Terrain } from \\\"./terrain\\\";\\n\\nexport interface Player {\\n    x: number;\\n    y: number; // eye height, world\\n    z: number;\\n    vx: number;\\n    vy: number;\\n    vz: number;\\n    yaw: number;\\n    pitch: number;\\n    onGround: boolean;\\n}\\n\\nexport interface PlayerInput {\\n    forward: number; // -1..1\\n    strafe: number; // -1..1\\n    sprint: boolean;\\n    jump: boolean;\\n}\\n\\nexport const EYE_HEIGHT = 1.6;\\nconst GRAVITY = 30;\\nconst JUMP_VEL = 11;\\nconst WALK_SPEED = 11;\\nconst SPRINT_SPEED = 17;\\nconst BOUND = 48;\\n\\nexport function createPlayer(x: number, z: number): Player {\\n    return { x, y: 0, z, vx: 0, vy: 0, vz: 0, yaw: 0, pitch: 0, onGround: false };\\n}\\n\\nexport function updatePlayer(p: Player, input: PlayerInput, terrain: Terrain, dt: number): void {\\n    const cy = Math.cos(p.yaw);\\n    const sy = Math.sin(p.yaw);\\n    // forward on XZ: (sin(yaw), 0, cos(yaw)); right: (cos(yaw), 0, -sin(yaw))\\n    const fx = sy;\\n    const fz = cy;\\n    const rx = cy;\\n    const rz = -sy;\\n    const speed = input.sprint ? SPRINT_SPEED : WALK_SPEED;\\n    const dx = fx * input.forward + rx * input.strafe;\\n    const dz = fz * input.forward + rz * input.strafe;\\n    const len = Math.hypot(dx, dz);\\n    const tx = len > 0 ? (dx / len) * speed : 0;\\n    const tz = len > 0 ? (dz / len) * speed : 0;\\n    const k = Math.min(1, 12 * dt);\\n    p.vx += (tx - p.vx) * k;\\n    p.vz += (tz - p.vz) * k;\\n\\n    p.vy -= GRAVITY * dt;\\n    if (input.jump && p.onGround) {\\n        p.vy = JUMP_VEL;\\n        p.onGround = false;\\n    }\\n\\n    p.x += p.vx * dt;\\n    p.z += p.vz * dt;\\n    p.y += p.vy * dt;\\n\\n    // soft map bounds\\n    if (p.x > BOUND) {\\n        p.x = BOUND;\\n        p.vx = Math.max(0, p.vx);\\n    }\\n    if (p.x < -BOUND) {\\n        p.x = -BOUND;\\n        p.vx = Math.min(0, p.vx);\\n    }\\n    if (p.z > BOUND) {\\n        p.z = BOUND;\\n        p.vz = Math.max(0, p.vz);\\n    }\\n    if (p.z < -BOUND) {\\n        p.z = -BOUND;\\n        p.vz = Math.min(0, p.vz);\\n    }\\n\\n    // ground snap\\n    const gh = terrain.sampleHeight(p.x, p.z);\\n    if (p.y <= gh + EYE_HEIGHT) {\\n        p.y = gh + EYE_HEIGHT;\\n        p.vy = 0;\\n        p.onGround = true;\\n    } else {\\n        p.onGround = false;\\n    }\\n}\", \"path\": \"/scratch/run3/babylon-lite-minecraft-fps/src/player.ts\"}","id":"call_5bd9786ba8854d7994e4e615","index":0,"name":"write"}}
{"kind":"delta","request":8813,"seq":8823,"t":596205,"tool_call":{"arguments":"{\"content\": \"import {\\n    addToScene,\\n    createBox,\\n    createStandardMaterial,\\n    removeFromScene,\\n    setShadowTaskCasterMeshes,\\n    type EngineContext,\\n    type Mesh,\\n    type SceneContext,\\n    type ShadowGenerator,\\n} from \\\"babylon-lite\\\";\\nimport type { Terrain } from \\\"./terrain\\\";\\nimport type { Player } from \\\"./player\\\";\\n\\nexport interface Crate {\\n    mesh: Mesh;\\n    size: number;\\n    alive: boolean;\\n}\\n\\nexport interface Weapon {\\n    ammo: number;\\n    clipSize: number;\\n    reloading: boolean;\\n    reloadTime: number;\\n    reloadDuration: number;\\n    fireCooldown: number;\\n    craters: number;\\n    hits: number;\\n    shots: number;\\n}\\n\\nexport function createWeapon(): Weapon {\\n    return {\\n        ammo: 20,\\n        clipSize: 20,\\n        reloading: false,\\n        reloadTime: 0,\\n        reloadDuration: 1.1,\\n        fireCooldown: 0,\\n        craters: 0,\\n        hits: 0,\\n        shots: 0,\\n    };\\n}\\n\\nexport function spawnCrates(engine: EngineContext, scene: SceneContext, terrain: Terrain, spots: [number, number][]): Crate[] {\\n    const crates: Crate[] = [];\\n    for (const [x, z] of spots) {\\n        const size = 2;\\n        const mesh = createBox(engine, size);\\n        mesh.position.set(x, terrain.sampleHeight(x, z) + size / 2, z);\\n        const mat = createStandardMaterial();\\n        mat.diffuseColor = [0.85, 0.45, 0.15];\\n        mat.specularColor = [0.2, 0.1, 0.05];\\n        mesh.material = mat;\\n        addToScene(scene, mesh);\\n        crates.push({ mesh, size, alive: true });\\n    }\\n    return crates;\\n}\\n\\nfunction rayAabb(\\n    ox: number,\\n    oy: number,\\n    oz: number,\\n    dx: number,\\n    dy: number,\\n    dz: number,\\n    cx: number,\\n    cy: number,\\n    cz: number,\\n    half: number\\n): number | null {\\n    let tmin = 0;\\n    let tmax = Infinity;\\n    const os = [ox, oy, oz];\\n    const cs = [cx, cy, cz];\\n    const ds = [dx, dy, dz];\\n    for (let i = 0; i < 3; i++) {\\n        if (Math.abs(ds[i]!) < 1e-8) {\\n            if (os[i]! - cs[i]! < -half || os[i]! - cs[i]! > half) return null;\\n        } else {\\n            let t1 = (cs[i]! - half - os[i]!) / ds[i]!;\\n            let t2 = (cs[i]! + half - os[i]!) / ds[i]!;\\n            if (t1 > t2) {\\n                const t = t1;\\n                t1 = t2;\\n                t2 = t;\\n            }\\n            tmin = Math.max(tmin, t1);\\n            tmax = Math.min(tmax, t2);\\n            if (tmin > tmax) return null;\\n        }\\n    }\\n    return tmin;\\n}\\n\\nexport function requestReload(w: Weapon): void {\\n    if (w.reloading || w.ammo === w.clipSize) return;\\n    w.reloading = true;\\n    w.reloadTime = w.reloadDuration;\\n}\\n\\nexport function updateWeapon(w: Weapon, dt: number): void {\\n    if (w.fireCooldown > 0) w.fireCooldown -= dt;\\n    if (w.reloading) {\\n        w.reloadTime -= dt;\\n        if (w.reloadTime <= 0) {\\n            w.reloading = false;\\n            w.ammo = w.clipSize;\\n        }\\n    }\\n}\\n\\n/** Hitscan shot from the player's eye. Returns true if the shot was fired. */\\nexport function tryFire(\\n    w: Weapon,\\n    p: Player,\\n    terrain: Terrain,\\n    crates: Crate[],\\n    scene: SceneContext,\\n    shadowGen: ShadowGenerator\\n): boolean {\\n    if (w.reloading || w.fireCooldown > 0) return false;\\n    if (w.ammo <= 0) {\\n        requestReload(w);\\n        return false;\\n    }\\n    w.ammo--;\\n    w.shots++;\\n    w.fireCooldown = 0.11;\\n\\n    const cp = Math.cos(p.pitch);\\n    const dx = Math.sin(p.yaw) * cp;\\n    const dy = Math.sin(p.pitch);\\n    const dz = Math.cos(p.yaw) * cp;\\n    const MAX = 160;\\n\\n    // nearest live crate hit\\n    let bestT = Infinity;\\n    let hitCrate: Crate | null = null;\\n    for (const c of crates) {\\n        if (!c.alive) continue;\\n       