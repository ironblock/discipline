{"arguments":"{\"limit\": 60, \"offset\": 104, \"path\": \"/scratch/run3/babylon-lite-minecraft-fps/src/main.ts\"}","id":"call_088670d0634e47698ffcd373","kind":"tool_call","name":"read","outcome":"ran","request":14215,"seq":14234,"shown":"Showing lines 104-163 of 178 total lines.\n\n---\n\n    const ammoEl = document.getElementById(\"ammo\") as HTMLDivElement;\n    const statusEl = document.getElementById(\"status\") as HTMLDivElement;\n    const overlayEl = document.getElementById(\"overlay\") as HTMLDivElement;\n\n    onBeforeRender(scene, (deltaMs) => {\n        const dt = Math.min(deltaMs / 1000, 0.05);\n\n        // aim\n        player.yaw += input.lookDX * 0.0022;\n        player.pitch -= input.lookDY * 0.0022;\n        player.pitch = Math.max(-1.5, Math.min(1.5, player.pitch));\n        input.lookDX = 0;\n        input.lookDY = 0;\n\n        // fire\n        if (input.fire && tryFire(weapon, player, terrain, crates, scene, shadowGen)) {\n            muzzle.intensity = 5;\n            gunKick = 0.07;\n            player.pitch += 0.005;\n        }\n        if (input.reload) {\n            requestReload(weapon);\n            input.reload = false;\n        }\n        updateWeapon(weapon, dt);\n\n        // movement\n        updatePlayer(player, input, terrain, dt);\n\n        // camera follows the player's eye\n        cam.position.set(player.x, player.y, player.z);\n        const cp = Math.cos(player.pitch);\n        cam.target.set(\n            player.x + Math.sin(player.yaw) * cp,\n            player.y + Math.sin(player.pitch),\n            player.z + Math.cos(player.yaw) * cp\n        );\n\n        // muzzle flash + gun kick decay\n        muzzle.intensity = Math.max(0, muzzle.intensity - dt * 25);\n        muzzle.position.set(player.x, player.y, player.z);\n        gunKick = Math.max(0, gunKick - dt * 0.5);\n        gun.position.set(0.3, -0.26, -0.85 + gunKick);\n\n        // HUD\n        ammoEl.textContent = `${weapon.ammo} / ${weapon.clipSize}`;\n        statusEl.textContent = weapon.reloading ? \"RELOADING\" : \"\";\n        overlayEl.classList.toggle(\"hidden\", input.locked);\n        fpsSmooth = fpsSmooth * 0.9 + (1000 / Math.max(deltaMs, 1)) * 0.1;\n        hudAccum += deltaMs;\n        if (hudAccum > 250) {\n            hudAccum = 0;\n            statsEl.innerHTML = `FPS ${Math.round(fpsSmooth)}<br>DRAWS ${engine.drawCallCount}<br>CRATERS ${weapon.craters}`;\n        }\n    });\n\n    await registerSceneWithShadowSupport(scene);\n    await startEngine(engine);\n    canvas.dataset.ready = \"true\";\n\n","t":8135002,"turn":4}
