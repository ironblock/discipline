near: cam.nearPlane,\n        far: cam.farPlane,\n    });\n    setShadowTaskCasterMeshes(light.shadowGenerator, [box]);\n\n    await registerSceneWithShadowSupport(scene);\n    await startEngine(engine);\n    canvas.dataset.drawCalls = String(engine.drawCallCount);\n    canvas.dataset.initMs = String(performance.now() - __initStart);\n    canvas.dataset.ready = \"true\";\n}\n\nmain().catch(console.error);\n===FREECAMERA===\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/camera/:\narc-rotate-controls.ts\narc-rotate.ts\ncamera.ts\nfree-camera-controls.ts\nfree-camera.ts\ngeospatial-camera-controls.ts\ngeospatial-camera-fly.ts\ngeospatial-camera.ts\ngeospatial-limits.ts\ngeospatial-movement.ts\nviewport.ts\n\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/mesh/:\nGaussianSplatting\ncompute-normals.ts\ncreate-box.ts\ncreate-capsule.ts\ncreate-cylinder.ts\ncreate-disc.ts\ncreate-extrude.ts\ncreate-ground.ts\ncreate-plane.ts\ncreate-polyhedron.ts\ncreate-ribbon.ts\ncreate-sphere.ts\ncreate-torus-knot.ts\ncreate-torus.ts\ncreate-tube.ts\ncsg.ts\ncsg2.ts\nhierarchy-instance-pool.ts\nmesh-dispose.ts\nmesh-factories.ts\nmesh.ts\npath3d.ts\npolyhedron-data.ts\nthin-instance-cull-binding.ts\nthin-instance-gpu-culling.ts\nthin-instance-gpu.ts\nthin-instance.ts\n\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/picking/:\ndeformed-geometry.ts\ndetailed-picking.ts\ngpu-picker.ts\ngs-picking-pipeline.ts\npicking-helpers.ts\npicking-info.ts\npicking-pipeline.ts\npicking-shader.ts\nray.ts\n\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/shadow/:\ncsm-directional-shadow-generator.ts\ncsm-receiver-registry.ts\ncsm-shadow-task-hooks.ts\nesm-directional-shadow-generator.ts\npcf-directional-shadow-generator.ts\npcf-shadow-task-hooks.ts\npcf-spotlight-shadow-generator.ts\nshadow-base.ts\nshadow-generator.ts\nshadow-renderable.ts\n","stdout_bytes":4006,"t":136290,"turn":3}
