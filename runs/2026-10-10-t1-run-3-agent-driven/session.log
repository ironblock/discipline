{"arguments":"{\"content\": \"import {\\n    computeNormals,\\n    createMeshFromData,\\n    addToScene,\\n    updateMeshNormals,\\n    updateMeshPositions,\\n    type EngineContext,\\n    type Material,\\n    type Mesh,\\n    type SceneContext,\\n} from \\\"babylon-lite\\\";\\n\\nexport const WORLD_SIZE = 100; // world units, spans -50..50\\nexport const GRID = 128; // cells per axis\\nexport const CHUNK = 16; // cells per chunk\\nconst VERTS = GRID + 1;\\nconst CELL = WORLD_SIZE / GRID;\\nconst HALF = WORLD_SIZE / 2;\\nconst CHUNKS = GRID / CHUNK;\\n\\nfunction hash2(ix: number, iz: number): number {\\n    let h = (ix * 374761393 + iz * 668265263) | 0;\\n    h = Math.imul(h ^ (h >>> 13), 1274126177);\\n    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;\\n}\\n\\nfunction valueNoise(x: number, z: number): number {\\n    const ix = Math.floor(x);\\n    const iz = Math.floor(z);\\n    const fx = x - ix;\\n    const fz = z - iz;\\n    const sx = fx * fx * (3 - 2 * fx);\\n    const sz = fz * fz * (3 - 2 * fz);\\n    const a = hash2(ix, iz);\\n    const b = hash2(ix + 1, iz);\\n    const c = hash2(ix, iz + 1);\\n    const d = hash2(ix + 1, iz + 1);\\n    return a + (b - a) * sx + (c - a) * sz + (a - b - c + d) * sx * sz;\\n}\\n\\nfunction smoothstep(e0: number, e1: number, x: number): number {\\n    const t = Math.min(1, Math.max(0, (x - e0) / (e1 - e0)));\\n    return t * t * (3 - 2 * t);\\n}\\n\\nexport interface TerrainHit {\\n    point: [number, number, number];\\n    normal: [number, number, number];\\n    dist: number;\\n}\\n\\nexport interface Terrain {\\n    heights: Float32Array;\\n    chunks: Mesh[];\\n    sampleHeight(x: number, z: number): number;\\n    carveCrater(wx: number, wz: number, radius: number, depth: number): void;\\n    raycast(ox: number, oy: number, oz: number, dx: number, dy: number, dz: number, maxDist: number): TerrainHit | null;\\n}\\n\\n/** Build a chunked, destructible heightfield arena. Adds all chunk meshes to the scene. */\\nexport function createTerrain(engine: EngineContext, scene: SceneContext, material: Material): Terrain {\\n    // ── heights ──────────────────────────────────────────────────────────\\n    const heights = new Float32Array(VERTS * VERTS);\\n    for (let gz = 0; gz < VERTS; gz++) {\\n        for (let gx = 0; gx < VERTS; gx++) {\\n            const x = -HALF + gx * CELL;\\n            const z = -HALF + gz * CELL;\\n            let h = (valueNoise(x * 0.08 + 31.7, z * 0.08 + 17.3) - 0.5) * 7;\\n            h += (valueNoise(x * 0.22 + 3.1, z * 0.22 + 9.7) - 0.5) * 1.6;\\n            // flatten the spawn area, raise rim mountains at the map edge\\n            h *= smoothstep(8, 24, Math.hypot(x, z));\\n            const rim = smoothstep(38, 49, Math.max(Math.abs(x), Math.abs(z)));\\n            h += rim * (6 + valueNoise(x * 0.15 + 55, z * 0.15 + 42) * 8);\\n            heights[gz * VERTS + gx] = h;\\n        }\\n    }\\n\\n    // ── static per-chunk index template (local vertex ids) ───────────────\\n    const chunkIndices: Uint32Array[] = [];\\n    for (let c = 0; c < CHUNKS * CHUNKS; c++) {\\n        const idx = new Uint32Array(CHUNK * CHUNK * 6);\\n        let k = 0;\\n        for (let iz = 0; iz < CHUNK; iz++) {\\n            for (let ix = 0; ix < CHUNK; ix++) {\\n                const a = iz * (CHUNK + 1) + ix;\\n                const b = a + 1;\\n                const c2 = a + (CHUNK + 1);\\n                const d = c2 + 1;\\n                idx[k++] = a;\\n                idx[k++] = b;\\n                idx[k++] = c2;\\n                idx[k++] = b;\\n                idx[k++] = d;\\n                idx[k++] = c2;\\n            }\\n        }\\n        chunkIndices.push(idx);\\n    }\\n\\n    function buildChunkGeometry(cx: number, cz: number): { positions: Float32Array; normals: Float32Array } {\\n        const positions = new Float32Array((CHUNK + 1) * (CHUNK + 1) * 3);\\n        let p = 0;\\n        for (let iz = 0; iz <= CHUNK; iz++) {\\n            for (let ix = 0; ix <= CHUNK; ix++) {\\n                const gx = cx * CHUNK + ix;\\n                const gz = cz * CHUNK + iz;\\n                positions[p++] = -HALF + gx * CELL;\\n                positions[p++] = heights[gz * VERTS + gx]!;\\n                positions[p++] = -HALF + gz * CELL;\\n            }\\n        }\\n        const normals64 = computeNormals(Array.from(positions), Array.from(chunkIndices[cz * CHUNKS + cx]!));\\n        return { positions, normals: new Float32Array(normals64) };\\n    }\\n\\n    const chunks: Mesh[] = [];\\n    for (let cz = 0; cz < CHUNKS; cz++) {\\n        for (let cx = 0; cx < CHUNKS; cx++) {\\n            const ci = cz * CHUNKS + cx;\\n            const { positions, normals } = buildChunkGeometry(cx, cz);\\n            const mesh = createMeshFromData(engine, `terrain-${cx}-${cz}`, positions, normals, chunkIndices[ci]!);\\n            mesh.material = material;\\n            mesh.receiveShadows = true;\\n            addToScene(scene, mesh);\\n            chunks.push(mesh);\\n        }\\n    }\\n\\n    // ── sampling ─────────────────────────────────────────────────────────\\n    function sampleHeight(x: number, z: number): number {\\n        let gx = (x + HALF) / CELL;\\n        let gz = (z + HALF) / CELL;\\n        if (gx < 0) gx = 0;\\n        else if (gx > GRID - 0.0001) gx = GRID - 0.0001;\\n        if (gz < 0) gz = 0;\\n        else if (gz > GRID - 0.0001) gz = GRID - 0.0001;\\n        const ix = Math.floor(gx);\\n        const iz = Math.floor(gz);\\n        const fx = gx - ix;\\n        const fz = gz - iz;\\n        const h00 = heights[iz * VERTS + ix]!;\\n        const h10 = heights[iz * VERTS + ix + 1]!;\\n        const h01 = heights[(iz + 1) * VERTS + ix]!;\\n        const h11 = heights[(iz + 1) * VERTS + ix + 1]!;\\n        return h00 * (1 - fx) * (1 - fz) + h10 * fx * (1 - fz) + h01 * (1 - fx) * fz + h11 * fx * fz;\\n    }\\n\\n    // ── destruction ──────────────────────────────────────────────────────\\n    function carveCrater(wx: number, wz: number, radius: number, depth: number): void {\\n        const x0 = Math.max(0, Math.floor((wx - radius + HALF) / CELL));\\n        const x1 = Math.min(GRID, Math.ceil((wx + radius + HALF) / CELL));\\n        const z0 = Math.max(0, Math.floor((wz - radius + HALF) / CELL));\\n        const z1 = Math.min(GRID, Math.ceil((wz + radius + HALF) / CELL));\\n        const dirty = new Set<number>();\\n        for (let gz = z0; gz <= z1; gz++) {\\n            for (let gx = x0; gx <= x1; gx++) {\\n                const vx = -HALF + gx * CELL;\\n                const vz = -HALF + gz * CELL;\\n                const d = Math.hypot(wx - vx, wz - vz);\\n                if (d >= radius) continue;\\n                const i = gz * VERTS + gx;\\n                const h = heights[i]!;\\n                const s = smoothstep(radius * 0.35, radius, d);\\n                const floor = h - depth;\\n                const target = floor + s * (h - floor);\\n                if (target < h) {\\n                    heights[i] = target;\\n                    dirty.add(Math.floor(gx / CHUNK) + Math.floor(gz / CHUNK) * CHUNKS);\\n                }\\n            }\\n        }\\n        for (const ci of dirty) {\\n            const cx = ci % CHUNKS;\\n            const cz = Math.floor(ci / CHUNKS);\\n            const { positions, normals } = buildChunkGeometry(cx, cz);\\n            const mesh = chunks[ci]!;\\n            updateMeshPositions(engine, mesh, positions);\\n            updateMeshNormals(engine, mesh, normals);\\n        }\\n    }\\n\\n    // ── raycast against the heightfield ──────────────────────────────────\\n    function raycast(\\n        ox: number,\\n        oy: number,\\n        oz: number,\\n        dx: number,\\n        dy: number,\\n        dz: number,\\n        maxDist: number\\n    ): TerrainHit | null {\\n        if (oy <= sampleHeight(ox, oz)) return null; // firing from inside the ground\\n        const step = 0.25;\\n        let prevT = 0;\\n        for (let t = step; t <= maxDist; t += step) {\\n            const px = ox + dx * t;\\n            const py = oy + dy * t;\\n            const pz = oz + dz * t;\\n            if (Math.abs(px) > HALF + 2 || Math.abs(pz) > HALF + 2) {\\n                prevT = t;\\n                continue;\\n            }\\n            if (py <= sampleHeight(px, pz)) {\\n                let lo = prevT;\\n                let hi = t;\\n                for (let i = 0; i < 12; i++) {\\n                    const mid = (lo + hi) / 2;\\n                    const mx = ox + dx * mid;\\n                    const my = oy + dy * mid;\\n                    const mz = oz + dz * mid;\\n                    if (my <= sampleHeight(mx, mz)) hi = mid;\\n                    else lo = mid;\\n                }\\n                const hx = ox + dx * hi;\\n                const hy = oy + dy * hi;\\n                const hz = oz + dz * hi;\\n                const e = 0.4;\\n                const nx = -(sampleHeight(hx + e, hz) - sampleHeight(hx - e, hz)) / (2 * e);\\n                const nz = -(sampleHeight(hx, hz + e) - sampleHeight(hx, hz - e)) / (2 * e);\\n                const inv = 1 / Math.hypot(nx, 1, nz);\\n                return { point: [hx, hy, hz], normal: [nx * inv, inv, nz * inv], dist: hi };\\n            }\\n            prevT = t;\\n        }\\n        return null;\\n    }\\n\\n    return { heights, chunks, sampleHeight, carveCrater, raycast };\\n}\", \"path\": \"/scratch/run3/babylon-lite-minecraft-fps/src/terrain.ts\"}","id":"call_d71a7d062e0d441b9e540a62","kind":"tool_call","name":"write","outcome":"ran","request":8797,"seq":8812,"shown":"Successfully created and wrote to new file: /scratch/run3/babylon-lite-minecraft-fps/src/terrain.ts.","t":572060,"turn":3}
