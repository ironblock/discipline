\n\\n/** The terrain mesh plus its tile grid. */\\nexport interface FpsTerrain {\\n    /** The single dense grid mesh (re-uploaded in place on destruction). */\\n    mesh: Mesh;\\n    /** Tiles indexed tz * TILE_COUNT + tx. */\\n    tiles: FpsTile[];\\n    /** Number of tiles destroyed so far. */\\n    destroyedCount: number;\\n    /** @internal Coarse noise grid for heightAt. */\\n    _noiseGrid: Float32Array;\\n}\\n\\n// ─── Seeded value noise ──────────────────────────────────────────────\\n\\nconst NOISE_CELLS = 8; // coarse cells per axis — low frequency, long undulations\\n\\n/** Mulberry32 — small seeded PRNG, allocation-free per call. */\\nfunction makeRng(seed: number): () => number {\\n    let a = seed >>> 0;\\n    return () => {\\n        a = (a + 0x6d2b79f5) >>> 0;\\n        let t = a;\\n        t = Math.imul(t ^ (t >>> 15), t | 1);\\n        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\\n        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\\n    };\\n}\\n\\nfunction smoothstep(t: number): number {\\n    return t * t * (3 - 2 * t);\\n}\\n\\n/** Bilinear value noise over the coarse grid, scaled to ±NOISE_AMPLITUDE. */\\nfunction noiseHeight(x: number, z: number, grid: Float32Array): number {\\n    const u = ((x + ARENA_SIZE / 2) / ARENA_SIZE) * NOISE_CELLS;\\n    const v = ((z + ARENA_SIZE / 2) / ARENA_SIZE) * NOISE_CELLS;\\n    const u0 = Math.min(Math.floor(u), NOISE_CELLS - 1);\\n    const v0 = Math.min(Math.floor(v), NOISE_CELLS - 1);\\n    const su = smoothstep(u - u0);\\n    const sv = smoothstep(v - v0);\\n    const n = NOISE_CELLS + 1;\\n    const a = grid[v0 * n + u0]! * (1 - su) + grid[v0 * n + u0 + 1]! * su;\\n    const b = grid[(v0 + 1) * n + u0]! * (1 - su) + grid[(v0 + 1) * n + u0 + 1]! * su;\\n    return (a * (1 - sv) + b * sv) * NOISE_AMPLITUDE;\\n}\\n\\n/** Ground height at a world (x, z) point — for spawning and bot logic. */\\nexport function terrainHeightAt(terrain: FpsTerrain, x: number, z: number): number {\\n    return noiseHeight(x, z, terrain._noiseGrid);\\n}\\n\\n// ─── Construction ────────────────────────────────────────────────────\\n\\n/**\\n * Build the FPS terrain: one dense grid mesh plus a static box collider per tile.\\n * The caller adds `terrain.mesh` to the scene.\\n */\\nexport function createFpsTerrain(engine: EngineContext, world: PhysicsWorld, seed = 1337): FpsTerrain {\\n    const rng = makeRng(seed);\\n    const grid = new Float32Array((NOISE_CELLS + 1) * (NOISE_CELLS + 1));\\n    for (let i = 0; i < grid.length; i++) {\\n        grid[i] = rng() * 2 - 1;\\n    }\\n\\n    const ground = createFlatGroundData({ width: ARENA_SIZE, height: ARENA_SIZE, subdivisions: TILE_COUNT });\\n    const cols = TILE_COUNT + 1;\\n    for (let row = 0; row < cols; row++) {\\n        for (let col = 0; col < cols; col++) {\\n            const i = (row * cols + col) * 3;\\n            ground.positions[i + 1] = noiseHeight(ground.positions[i]!, ground.positions[i + 2]!, grid);\\n        }\\n    }\\n    const normals = computeNormals(ground.positions, ground.indices);\\n    const mesh = createMeshFromData(engine, \\\"fpsTerrain\\\", ground.positions, normals, ground.indices, ground.uvs);\\n\\n    const tiles: FpsTile[] = [];\\n    for (let tz = 0; tz < TILE_COUNT; tz++) {\\n        for (let tx = 0; tx < TILE_COUNT; tx++) {\\n            // Corner heights of this tile (4 grid vertices).\\n            let yTop = -Infinity;\\n            let yBottom = Infinity;\\n            for (let dr = 0; dr <= 1; dr++) {\\n                for (let dc = 0; dc <= 1; dc++) {\\n                    const y = ground.positions[((tz + dr) * cols + (tx + dc)) * 3 + 1]!;\\n                    if (y > yTop) {\\n                        yTop = y;\\n                    }\\n                    if (y < yBottom) {\\n                        yBottom = y;\\n                    }\\n                }\\n            }\\n            const cx = -ARENA_SIZE / 2 + tx * TILE_SIZE + TILE_SIZE / 2;\\n            const cz = -ARENA_SIZE / 2 + tz * TILE_SIZE + TILE_SIZE / 2;\\n            // Box top sits at the tile's highest corner so characters never fall through;\\n            // a minimum half-height keeps the box non-degenerate on flat tiles.\\n            const halfH = Math.max((yTop - yBottom) / 2, 0.5);\\n            const node = createTransformNode(\\\"fpsTile\\\", cx, yTop - halfH, cz);\\n            const body = createPhysicsBody(world, node, PhysicsMotionType.STATIC);\\n            const shape = createPhysicsShape(world, {\\n                type: PhysicsShapeType.BOX,\\n                parameters: { extents: { x: TILE_SIZE / 2, y: halfH, z: TILE_SIZE / 2 } },\\n            });\\n            setPhysicsBodyShape(world, body, shape);\\n            // Low friction for Quake-style ground slide; no bounce.\\n            setPhysicsShapeMaterial(world, shape, 0.1, 0);\\n            setPhysicsShapeFilterMembershipMask(world, shape, TERRAIN_LAYER);\\n            tiles.push({ tx, tz, alive: true, body, obstacle: null });\\n        }\\n    }\\n\\n    return { mesh, tiles, destroyedCount: 0, _noiseGrid: grid };\\n}\\n\\n/** Look up the tile containing a world (x, z) point, or null outside the arena. */\\nexport function tileFromPoint(x: number, z: number): FpsTile | null {\\n    const tx = Math.floor((x + ARENA_SIZE / 2) / TILE_SIZE);\\n    const tz = Math.floor((z + ARENA_SIZE / 2) / TILE_SIZE);\\n    if (tx < 0 || tx >= TILE_COUNT || tz < 0 || tz >= TILE_COUNT) {\\n        return null;\\n    }\\n    return null; // placeholder replaced below\\n}\\n\\n/**\\n * Destroy one tile: drop its 6 indices from the grid mesh, recompute normals, re-upload\\n * in place, remove its static body, and mark the hole on the navmesh.\\n */\\nexport function destroyTerrainTile(terrain: FpsTerrain, engine: EngineContext, world: PhysicsWorld, nav: NavigationPlugin | null, tile: FpsTile): void {\\n    if (!tile.alive) {\\n        return;\\n    }\\n    tile.alive = false;\\n    terrain.destroyedCount++;\\n\\n    const mesh = terrain.mesh;\\n    const m = mesh as unknown as { _cpuIndices?: Uint32Array; _cpuPositions?: Float32Array; _cpuUvs?: Float32Array };\\n    const old = m._cpuIndices;\\n    if (!old) {\\n        return;\\n    }\\n    const start = (tile.tz * TILE_COUNT + tile.tx) * 6;\\n    const next = new Uint32Array(old.length - 6);\\n    next.set(old.subarray(0, start), 0);\\n    next.set(old.subarray(start + 6), start);\\n    const normals = computeNormals(m._cpuPositions!, next);\\n    resizeMeshGeometry(engine, mesh, m._cpuPositions!, normals, next, m._cpuUvs);\\n\\n    if (tile.body) {\\n        removePhysicsBody(world, tile.body);\\n        tile.body = null;\\n    }\\n    if (nav) {\\n        tile.obstacle = addBoxObstacle(nav, { x: -ARENA_SIZE / 2 + tile.tx * TILE_SIZE + TILE_SIZE / 2, y: 0, z: -ARENA_SIZE / 2 + tile.tz * TILE_SIZE + TILE_SIZE / 2 }, { x: TILE_SIZE / 2, y: 2, z: TILE_SIZE / 2 }, 0);\\n    }\\n}\", \"path\": \"~/git/reference/Babylon/Babylon-Lite/lab/lite/src/lite/fps-terrain.ts\"}","id":"call_17e20840b2d743f8bd9cb860","kind":"tool_call","name":"write","outcome":"ran","request":46821,"seq":47401,"shown":"Successfully created and wrote to new file: ~/git/reference/Babylon/Babylon-Lite/lab/lite/src/lite/fps-terrain.ts.","t":2084808,"turn":6}
