{"arguments":"{\"limit\": 120, \"offset\": 188, \"path\": \"~/git/reference/Babylon/Babylon-Lite/lab/lite/src/lite/scene252.ts\"}","id":"call_1e9c65a9d21b488ab000b73c","kind":"tool_call","name":"read","outcome":"ran","request":93195,"seq":93324,"shown":"Showing lines 188-307 of 594 total lines.\n\n---\n\n    const nav = await createNavigationPluginAsync({ locateFile: () => \"/recast-navigation.wasm\" });\n    createNavMesh(nav, [terrain.mesh], {\n        cs: 0.5,\n        ch: 0.5,\n        walkableSlopeAngle: 45,\n        walkableHeight: 1,\n        walkableClimb: 1,\n        walkableRadius: 0.5,\n        maxEdgeLen: 12,\n        maxSimplificationError: 1.3,\n        minRegionArea: 8,\n        mergeRegionArea: 20,\n        maxVertsPerPoly: 6,\n        detailSampleDist: 6,\n        detailSampleMaxError: 1,\n    });\n    const crowd = createNavCrowd(nav, BOT_COUNT, 0.5);\n\n    // Bot display — one capsule mesh rendered as thin instances.\n    const botMesh = createCapsule(engine, { height: CAP_HEIGHT, radius: CAP_RADIUS, tessellation: 12 });\n    const botMat = createStandardMaterial();\n    botMat.diffuseColor = [0.9, 0.4, 0.2];\n    botMat.specularColor = [0.1, 0.05, 0.05];\n    botMesh.material = botMat;\n    addToScene(scene, botMesh);\n    const botMatrices = new Float32Array(BOT_COUNT * 16);\n    setThinInstances(botMesh, botMatrices, BOT_COUNT);\n\n    const bots: Bot[] = [];\n    const botSpawns = [\n        { x: -30, z: 30 },\n        { x: 30, z: 30 },\n        { x: -30, z: -30 },\n        { x: 30, z: -30 },\n    ];\n    for (let i = 0; i < BOT_COUNT; i++) {\n        const s = botSpawns[i]!;\n        const p = findRandomPointAroundCircle(nav, { x: s.x, y: 0, z: s.z }, 8);\n        const cc = createPhysicsCharacterController(world, { x: p.x, y: p.y + CAP_HEIGHT / 2, z: p.z }, { capsuleHeight: CAP_HEIGHT, capsuleRadius: CAP_RADIUS });\n        cc.staticFriction = 0;\n        cc.dynamicFriction = 0.1;\n        const agentIndex = addAgent(crowd, p, {\n            radius: 0.5,\n            height: CAP_HEIGHT,\n            maxAcceleration: 20,\n            maxSpeed: BOT_SPEED,\n            collisionQueryRange: 4,\n            pathOptimizationRange: 0,\n            separationWeight: 1,\n        });\n        bots.push({ cc, agentIndex, hp: 100, dead: false, respawnAt: 0, nextRetarget: 0, nextShot: 1 + i * 0.3, velY: 0, heading: 0 });\n    }\n\n    // Debris — dynamic box bodies rendered as thin instances (ring buffer).\n    const debrisMesh = createBox(engine, 0.6);\n    const debrisMat = createStandardMaterial();\n    debrisMat.diffuseColor = [0.55, 0.5, 0.45];\n    debrisMat.specularColor = [0.05, 0.05, 0.05];\n    debrisMesh.material = debrisMat;\n    addToScene(scene, debrisMesh);\n    const debrisMatrices = new Float32Array(DEBRIS_COUNT * 16);\n    setThinInstances(debrisMesh, debrisMatrices, DEBRIS_COUNT);\n    const debris: Debris[] = [];\n    for (let i = 0; i < DEBRIS_COUNT; i++) {\n        debris.push({ body: null, alive: false, expiresAt: 0 });\n    }\n    let debrisNext = 0;\n\n    // HUD — screen-space text layers composited over the 3D frame (clear: false).\n    const font = await loadFont(\"/fonts/Inter.ttf\");\n    const hudData = createDefaultTextData(font, 28, \"HP 100   KILLS 0   TILES 0\", [1, 1, 1, 1], { maxWidth: 1200, align: \"left\" });\n    const hudLayer = createTextLayer(hudData, { positionPx: { x: 24, y: 24 }, scale: 1, rotationRad: 0, opacity: 1 });\n    const crossData = createDefaultTextData(font, 20, \"+\", [1, 1, 1, 1], {});\n    const crossLayer = createTextLayer(crossData, { positionPx: { x: window.innerWidth / 2 - 8, y: window.innerHeight / 2 - 10 }, scale: 1, rotationRad: 0, opacity: 0.9 });\n    const tr = createTextRenderer(engine, { layers: [hudLayer, crossLayer], clear: false });\n\n    // Input + audio (DOM side).\n    const input = createFpsInput(canvas);\n    const audio = createFpsAudio();\n    input.onLockChange((locked) => {\n        if (locked) {\n            audio.unlock();\n        }\n    });\n\n    // ─── Game state ──────────────────────────────────────────────────\n    let gameTime = 0;\n    let yaw = 0;\n    let pitch = 0;\n    let playerHp = 100;\n    let kills = 0;\n    let invulnerableUntil = 3;\n    let lastShot = -1;\n    const playerVel: Vec3 = { x: 0, y: 0, z: 0 };\n    let lastHudText = \"\";\n\n    const eyePos = (): Vec3 => {\n        const p = player.getPosition();\n        return { x: p.x, y: p.y + EYE_HEIGHT, z: p.z };\n    };\n    const forwardDir = (): Vec3 => {\n        const cp = Math.cos(pitch);\n        return { x: Math.sin(yaw) * cp, y: Math.sin(pitch), z: Math.cos(yaw) * cp };\n    };\n\n    const respawnPlayer = (): void => {\n        player.setPosition({ x: SPAWN.x, y: terrainHeightAt(terrain, SPAWN.x, SPAWN.z) + CAP_HEIGHT / 2 + 0.1, z: SPAWN.z });\n        playerVel.x = 0;\n        playerVel.y = 0;\n        playerVel.z = 0;\n        playerHp = 100;\n        invulnerableUntil = gameTime + 3;\n    };\n\n    const damagePlayer = (amount: number): void => {\n        if (gameTime < invulnerableUntil) {\n            return;\n        }\n        playerHp -= amount;\n        audio.damage();\n","t":4974008,"turn":6}
