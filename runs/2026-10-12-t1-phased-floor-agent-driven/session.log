n-Lite/packages/babylon-lite/src/navigation/navigation.ts:500:export function computePath(plugin: NavigationPlugin, start: Vec3, end: Vec3): Vec3[];\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:528:export function createNavCrowd(plugin: NavigationPlugin, maxAgents: number, maxAgentRadius: number): NavCrowd;\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:536:export function addAgent(crowd: NavCrowd, position: Vec3, params: AgentParameters): number;\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:555:export function getAgentPosition(crowd: NavCrowd, index: number): Vec3;\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:561:export function getAgentVelocity(crowd: NavCrowd, index: number): Vec3;\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:567:export function agentGoto(crowd: NavCrowd, index: number, destination: Vec3): void;\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:572:export function updateNavCrowd(crowd: NavCrowd, dt: number): void;\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:583:export function findRandomPointAroundCircle(plugin: NavigationPlugin, position: Vec3, radius: number): Vec3;\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:590:export function findRandomPoint(plugin: NavigationPlugin): Vec3;\n~/git/reference/Babylon/Babylon-Lite/packages/babylon-lite/src/navigation/navigation.ts:615:export function raycast(plugin: NavigationPlugin, start: Vec3, end: Vec3): { hit: boolean; hitPoint?: Vec3 };\n```\n\n(`createNavMesh` at :192 is what makes navmesh buildable from the generated noise-terrain mesh; `computePath`/`findRandomPoint`/`raycast` are patrol/seek/line-of-sight; the crowd functions give bot-vs-bot steering.)\n\n2. Not needed now, may matter later:\n\nPOINTER: `createNavMeshFromSources` builds a navmesh from `NavMeshSource[]` instead of raw meshes — may matter if the noise-terrain mesh needs filtering (e.g., excluding holes/steep faces) before navmesh generation (navigation.ts:200)\nPOINTER: `createDebugNavMeshGeometry` returns positions/normals/indices for rendering the navmesh — useful for debugging bot paths on generated terrain (navigation.ts:404)\nPOINTER: `setNavigationRandomSeed`/`getNavigationRandomSeed` — seedable RNG for deterministic bot behavior, useful for reproducible AI tests (navigation.ts:597, 602)\nPOINTER: `addBoxObstacle`/`addCylinderObstacle`/`removeObstacle`/`updateNavMeshObstacles` — dynamic navmesh obstacles; relevant when destructible terrain opens holes or debris blocks paths (navigation.ts:647–681)\n\nNext: I'll record the findings (port conflict, scope update, API anchors) and then continue with the scope response and the transition proposal.","timings":{"cache_n":42752,"draft_n":9667,"draft_n_accepted":4550,"predicted_ms":79110.0,"predicted_n":5931,"prompt_ms":7150.0,"prompt_n":3015},"to_request":11176,"usage":{"cached_tokens":42752,"completion_tokens":5931,"prompt_tokens":45767}}
