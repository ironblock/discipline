{"arguments":"{\"file_path\": \"~/git/reference/Babylon/Babylon-Lite/lab/vite.config.ts\", \"new_string\": \"/**\\n * Serve @recast-navigation dist files raw, bypassing Vite's dev transform.\\n * Vite dev appends an inline base64 source map to every served module; for the\\n * 560 KB recast glue that bloats the response to ~2 MB, which the lab's\\n * constrained test browser cannot finish within its per-page load window (the\\n * module import never settles — no rejection, just a stall, on every page).\\n * The three dist files (core, generators, wasm glue) are self-contained native\\n * ESM with no imports to rewrite, so raw bytes are a drop-in replacement.\\n */\\nfunction serveRecastRawPlugin(): Plugin {\\n    return {\\n        name: \\\"serve-recast-raw\\\",\\n        configureServer(server) {\\n            server.middlewares.use((req, res, next) => {\\n                const url = (req.url ?? \\\"\\\").split(\\\"?\\\")[0];\\n                if (!url.startsWith(\\\"/@fs/\\\") || !url.includes(\\\"/@recast-navigation/\\\")) {\\n                    next();\\n                    return;\\n                }\\n                const fsPath = url.slice(\\\"/@fs/\\\".length);\\n                readFile(fsPath, (err, data) => {\\n                    if (err) {\\n                        next();\\n                        return;\\n                    }\\n                    res.statusCode = 200;\\n                    res.setHeader(\\\"Content-Type\\\", \\\"text/javascript; charset=utf-8\\\");\\n                    res.setHeader(\\\"Cache-Control\\\", \\\"no-cache\\\");\\n                    res.end(data);\\n                });\\n            });\\n        },\\n    };\\n}\\n\\nexport default defineConfig({\\n    plugins: [pagesDemoPlugin(), compatScenesPlugin(), serveReferenceImages(), apiDocsPlugin(), tabContentPlugin(), serveRecastRawPlugin()],\", \"old_string\": \"export default defineConfig({\\n    plugins: [pagesDemoPlugin(), compatScenesPlugin(), serveReferenceImages(), apiDocsPlugin(), tabContentPlugin()],\"}","id":"call_e38cfca4ee6b4c2fad710942","kind":"tool_call","name":"edit","outcome":"ran","request":201593,"seq":201715,"shown":"The file: ~/git/reference/Babylon/Babylon-Lite/lab/vite.config.ts has been updated. Showing lines 711-755 of 808 from the edited file:\n\n---\n\n        },\n    };\n}\n\n/**\n * Serve @recast-navigation dist files raw, bypassing Vite's dev transform.\n * Vite dev appends an inline base64 source map to every served module; for the\n * 560 KB recast glue that bloats the response to ~2 MB, which the lab's\n * constrained test browser cannot finish within its per-page load window (the\n * module import never settles — no rejection, just a stall, on every page).\n * The three dist files (core, generators, wasm glue) are self-contained native\n * ESM with no imports to rewrite, so raw bytes are a drop-in replacement.\n */\nfunction serveRecastRawPlugin(): Plugin {\n    return {\n        name: \"serve-recast-raw\",\n        configureServer(server) {\n            server.middlewares.use((req, res, next) => {\n                const url = (req.url ?? \"\").split(\"?\")[0];\n                if (!url.startsWith(\"/@fs/\") || !url.includes(\"/@recast-navigation/\")) {\n                    next();\n                    return;\n                }\n                const fsPath = url.slice(\"/@fs/\".length);\n                readFile(fsPath, (err, data) => {\n                    if (err) {\n                        next();\n                        return;\n                    }\n                    res.statusCode = 200;\n                    res.setHeader(\"Content-Type\", \"text/javascript; charset=utf-8\");\n                    res.setHeader(\"Cache-Control\", \"no-cache\");\n                    res.end(data);\n                });\n            });\n        },\n    };\n}\n\nexport default defineConfig({\n    plugins: [pagesDemoPlugin(), compatScenesPlugin(), serveReferenceImages(), apiDocsPlugin(), tabContentPlugin(), serveRecastRawPlugin()],\n    optimizeDeps: {\n        // BJS uses prototype-patching side-effect imports (e.g. abstractEngine.dom.js).\n        // babylon-lite uses ?raw WGSL imports that esbuild can't handle.\n        // Exclude both from Vite's dep optimizer.","t":12186415,"turn":17}
