ions;\n    mesh._cpuNormals = normals;\n    mesh._cpuUvs = uvs;\n    mesh._cpuIndices = indices;\n    engine._dlr?.m(mesh, uvs2 ?? null, tangents ?? null, colors ?? null, indices, \"uint32\");\n","stdout_bytes":3556,"t":1566126,"turn":6}
