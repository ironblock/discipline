{"kind":"delta","request":180386,"seq":182030,"t":11006269,"tool_call":{"arguments":"{\"file_path\": \"~/git/reference/Babylon/Babylon-Lite/lab/lite/src/lite/scene252.ts\", \"new_string\": \"// This browser stalls on WebAssembly.instantiateStreaming for the second wasm\\n    // module (recast after Havok) — the promise never settles, so the emscripten\\n    // glue's ArrayBuffer fallback (which only runs on a rejection) is unreachable.\\n    // Force streaming to reject so both wasm loads take the ArrayBuffer path.\\n    // TEMP diagnostic: log every .wasm fetch and every (rejected) streaming call\\n    // so the next reload shows exactly how far the recast load gets.\\n    const __fetch = window.fetch;\\n    window.fetch = (input: RequestInfo | URL, init?: RequestInit) => {\\n        const url = typeof input === \\\"string\\\" ? input : input instanceof URL ? input.href : input.url;\\n        if (url.includes(\\\".wasm\\\")) {\\n            console.warn(`scene252 init: fetch ${url}`);\\n            const p = __fetch(input, init);\\n            p.then(\\n                (r) => console.warn(`scene252 init: fetch ${url} -> ${r.status}`),\\n                (e) => console.warn(`scene252 init: fetch ${url} -> rejected: ${e}`),\\n            );\\n            return p;\\n        }\\n        return __fetch(input, init);\\n    };\\n    WebAssembly.instantiateStreaming = (() => {\\n        console.warn(\\\"scene252 init: instantiateStreaming called -> rejecting (forcing ArrayBuffer)\\\");\\n        return Promise.reject(new Error(\\\"scene252: forcing ArrayBuffer wasm path\\\"));\\n    }) as typeof WebAssembly.instantiateStreaming;\\n    mark(\\\"force-arraybuffer\\\");\", \"old_string\": \"// This browser stalls on WebAssembly.instantiateStreaming for the second wasm\\n    // module (recast after Havok) — the promise never settles, so the emscripten\\n    // glue's ArrayBuffer fallback (which only runs on a rejection) is unreachable.\\n    // Force streaming to reject so both wasm loads take the ArrayBuffer path.\\n    WebAssembly.instantiateStreaming = (async () => {\\n        throw new Error(\\\"scene252: forcing ArrayBuffer wasm path\\\");\\n    }) as typeof WebAssembly.instantiateStreaming;\\n    mark(\\\"force-arraybuffer\\\");\"}","id":"call_2faa69701bde4090923a2a3f","index":0,"name":"edit"}}
