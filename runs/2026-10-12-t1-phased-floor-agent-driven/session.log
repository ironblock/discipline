{"kind":"delta","request":69810,"seq":73770,"t":3677766,"tool_call":{"arguments":"{\"file_path\": \"~/git/reference/Babylon/Babylon-Lite/lab/lite/src/lite/scene252.ts\", \"new_string\": \"/** Ray (origin + normalized dir, clamped to RAY_RANGE) vs a vertical capsule. Returns distance or null. */\\nfunction rayVsCapsule(o: Vec3, d: Vec3, center: Vec3, halfH: number, r: number): number | null {\\n    const ax = center.x;\\n    const ay = center.y - halfH; // bottom cap center\\n    const az = center.z;\\n    const hh = halfH * 2;\\n    const wx = o.x - ax;\\n    const wy = o.y - ay;\\n    const wz = o.z - az;\\n    const b = d.y * hh;\\n    const c = d.x * wx + d.y * wy + d.z * wz;\\n    const e = hh * wy;\\n    const det = hh * hh - b * b;\\n    let best: number | null = null;\\n    // Cylindrical band (axis between the two caps).\\n    if (det > 1e-8) {\\n        const t = (b * e - c * hh * hh) / det;\\n        const u = (e - b * c) / det;\\n        if (t >= 0 && t <= RAY_RANGE && u >= 0 && u <= 1) {\\n            const px = o.x + d.x * t - ax;\\n            const py = o.y + d.y * t - (ay + hh * u);\\n            const pz = o.z + d.z * t - az;\\n            if (px * px + py * py + pz * pz <= r * r) {\\n                best = t;\\n            }\\n        }\\n    }\\n    // End caps, treated as spheres.\\n    const cap = (cy: number): number | null => {\\n        const qx = o.x - ax;\\n        const qy = o.y - cy;\\n        const qz = o.z - az;\\n        const t = -(d.x * qx + d.y * qy + d.z * qz);\\n        if (t < 0 || t > RAY_RANGE) {\\n            return null;\\n        }\\n        const px = o.x + d.x * t - ax;\\n        const py = o.y + d.y * t - cy;\\n        const pz = o.z + d.z * t - az;\\n        if (px * px + py * py + pz * pz <= r * r) {\\n            return t;\\n        }\\n        return null;\\n    };\\n    const tb = cap(ay);\\n    if (tb !== null && (best === null || tb < best)) {\\n        best = tb;\\n    }\\n    const tt = cap(ay + hh);\\n    if (tt !== null && (best === null || tt < best)) {\\n        best = tt;\\n    }\\n    return best;\\n}\", \"old_string\": \"/** Ray (origin + normalized dir, length RAY_RANGE) vs vertical capsule. Returns distance or null. */\\nfunction rayVsCapsule(o: Vec3, d: Vec3, center: Vec3, halfH: number, r: number): number | null {\\n    const ax = center.x;\\n    const ay = center.y - halfH;\\n    const az = center.z;\\n    const wx = o.x - ax;\\n    const wy = o.y - ay;\\n    const wz = o.z - az;\\n    const hh = halfH * 2;\\n    const b = d.y * hh;\\n    const c = d.x * wx + d.y * wy + d.z * wz;\\n    const e = hh * wy;\\n    const det = hh * hh - b * b;\\n    if (det < 1e-8) {\\n        return null;\\n    }\\n    const t = (b * e - c * hh * hh) / det;\\n    const u = (hh * e - b * c) / det;\\n    if (t < 0 || u < 0 || u > 1) {\\n        return null;\\n    }\\n    const px = o.x + d.x * t - ax;\\n    const py = o.y + d.y * t - (ay + hh * u);\\n    const pz = o.z + d.z * t - az;\\n    if (px * px + py * py + pz * pz > r * r) {\\n        return null;\\n    }\\n    return Math.min(t, RAY_RANGE);\\n}\"}","id":"call_80246438d5fd40b798aae61c","index":0,"name":"edit"}}
