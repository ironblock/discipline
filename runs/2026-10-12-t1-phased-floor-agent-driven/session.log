{"kind":"delta","request":54758,"seq":55244,"t":2467224,"tool_call":{"arguments":"{\"content\": \"// DOM input for the FPS demo — pointer-lock mouse look + WASD/space keyboard state.\\n// Lite has no input module by design; the demo owns its DOM listeners.\\n\\nexport interface FpsInput {\\n    /** True while the pointer is locked to the canvas. */\\n    locked: boolean;\\n    /** Move keys (WASD / arrows). */\\n    forward: boolean;\\n    back: boolean;\\n    left: boolean;\\n    right: boolean;\\n    jump: boolean;\\n    /** Mouse-look delta accumulated since the last read; resets to zero on read. */\\n    consumeLookDelta(): { dx: number; dy: number };\\n    /** Subscribe to shot requests (mouse-down while locked). Returns a disposer. */\\n    onFire(cb: () => void): () => void;\\n    /** Subscribe to pointer-lock changes. Returns a disposer. */\\n    onLockChange(cb: (locked: boolean) => void): () => void;\\n    /** Remove all listeners. */\\n    dispose(): void;\\n}\\n\\nexport function createFpsInput(canvas: HTMLCanvasElement): FpsInput {\\n    const state = { forward: false, back: false, left: false, right: false, jump: false };\\n    let locked = false;\\n    let dx = 0;\\n    let dy = 0;\\n    const fireSubs: (() => void)[] = [];\\n    const lockSubs: ((locked: boolean) => void)[] = [];\\n\\n    const setKey = (code: string, down: boolean): void => {\\n        switch (code) {\\n            case \\\"KeyW\\\":\\n            case \\\"ArrowUp\\\":\\n                state.forward = down;\\n                break;\\n            case \\\"KeyS\\\":\\n            case \\\"ArrowDown\\\":\\n                state.back = down;\\n                break;\\n            case \\\"KeyA\\\":\\n            case \\\"ArrowLeft\\\":\\n                state.left = down;\\n                break;\\n            case \\\"KeyD\\\":\\n            case \\\"ArrowRight\\\":\\n                state.right = down;\\n                break;\\n            case \\\"Space\\\":\\n                state.jump = down;\\n                break;\\n        }\\n    };\\n\\n    const onKeyDown = (e: KeyboardEvent): void => {\\n        if (e.code === \\\"Space\\\") {\\n            e.preventDefault();\\n        }\\n        setKey(e.code, true);\\n    };\\n    const onKeyUp = (e: KeyboardEvent): void => {\\n        setKey(e.code, false);\\n    };\\n    const onMouseMove = (e: MouseEvent): void => {\\n        if (!locked) {\\n            return;\\n        }\\n        dx += e.movementX;\\n        dy += e.movementY;\\n    };\\n    const onMouseDown = (e: MouseEvent): void => {\\n        if (!locked) {\\n            // First click requests pointer lock instead of firing.\\n            void canvas.requestPointerLock().catch(() => undefined);\\n            return;\\n        }\\n        if (e.button === 0) {\\n            for (const cb of fireSubs) {\\n                cb();\\n            }\\n        }\\n    };\\n    const onLockChange = (): void => {\\n        locked = document.pointerLockElement === canvas;\\n        for (const cb of lockSubs) {\\n            cb(locked);\\n        }\\n    };\\n\\n    canvas.addEventListener(\\\"mousedown\\\", onMouseDown);\\n    document.addEventListener(\\\"mousemove\\\", onMouseMove);\\n    document.addEventListener(\\\"pointerlockchange\\\", onLockChange);\\n    window.addEventListener(\\\"keydown\\\", onKeyDown);\\n    window.addEventListener(\\\"keyup\\\", onKeyUp);\\n\\n    return {\\n        get locked() {\\n            return locked;\\n        },\\n        get forward() {\\n            return state.forward;\\n        },\\n        get back() {\\n            return state.back;\\n        },\\n        get left() {\\n            return state.left;\\n        },\\n        get right() {\\n            return state.right;\\n        },\\n        get jump() {\\n            return state.jump;\\n        },\\n        consumeLookDelta(): { dx: number; dy: number } {\\n            const out = { dx, dy };\\n            dx = 0;\\n            dy = 0;\\n            return out;\\n        },\\n        onFire(cb: () => void): () => void {\\n            fireSubs.push(cb);\\n            return () => {\\n                const i = fireSubs.indexOf(cb);\\n                if (i >= 0) {\\n                    fireSubs.splice(i, 1);\\n                }\\n            };\\n        },\\n        onLockChange(cb: (locked: boolean) => void): () => void {\\n            lockSubs.push(cb);\\n            return () => {\\n                const i = lockSubs.indexOf(cb);\\n                if (i >= 0) {\\n                    lockSubs.splice(i, 1);\\n                }\\n            };\\n        },\\n        dispose(): void {\\n            canvas.removeEventListener(\\\"mousedown\\\", onMouseDown);\\n            document.removeEventListener(\\\"mousemove\\\", onMouseMove);\\n            document.removeEventListener(\\\"pointerlockchange\\\", onLockChange);\\n            window.removeEventListener(\\\"keydown\\\", onKeyDown);\\n            window.removeEventListener(\\\"keyup\\\", onKeyUp);\\n        },\\n    };\\n}\", \"path\": \"~/git/reference/Babylon/Babylon-Lite/lab/lite/src/lite/fps-input.ts\"}","id":"call_8c08317af54246e7ac4978e6","index":0,"name":"write"}}
