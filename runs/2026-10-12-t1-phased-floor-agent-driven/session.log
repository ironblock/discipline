in the module that never completes — the module never finishes executing.\n\nSince there are no console errors, it's probably a promise that never resolves. Candidates:\n- `createNavigationPluginAsync` — loads recast-navigation.wasm. If the file 404s, the fetch fails → probably an error. But the user says no errors... unless the error is swallowed.\n- Font `loadFont` — fetches /fonts/Inter.ttf. If 404 → error should show up.\n- Actually, it might be the order: if scene252 awaits the nav plugin before startEngine, and the wasm load stalls...\n\nLet me check: does lab/public/recast-navigation.wasm exist? According to the working set it exists. And HavokPhysics.wasm — exists (scene40 uses it).\n\nBetter to actually read scene252.ts and trace the initialization. Let me do that right now.\n\nAlso check loader.js to understand the spinner: it probably shows \"Initializing Babylon Lite\" until `canvas.dataset.ready` is set. If the scene code sets dataset.ready after startEngine, then the hang is before that.\n\nPlan:\n1. Read scene252.ts (in full).\n2. Check lab/public for recast-navigation.wasm, HavokPhysics.wasm, fonts/Inter.ttf.\n3. curl the assets through the dev server and check they return 200.\n4. Identify the awaited step that's hanging.\n\nLet me do these in parallel.\n","seq":99611,"t":5528093,"text":"\n\nNo errors but stuck at init smells like an `await` that never resolves (wasm fetch, font load, or a callback that never fires). Let me trace the init path in `scene252.ts` and check the assets it depends on.\n\n\n","timings":{"cache_n":76288,"draft_n":2499,"draft_n_accepted":689,"predicted_ms":18850.0,"predicted_n":1046,"prompt_ms":3680.0,"prompt_n":2273},"to_request":99290,"usage":{"cached_tokens":76288,"completion_tokens":1046,"prompt_tokens":78561}}
{"arguments":"{\"path\": \"~/git/reference/Babylon/Babylon-Lite/lab/lite/src/lite/scene252.ts\"}","id":"call_0681b0a13c664ff991e6b5cd","kind":"tool_call","name":"read","outcome":"ran","request":99290,"seq":99612,"shown":"// Scene 252: Quake-style FPS — destructible noise terrain (tile removal), shooting,\n// navmesh bots, GPU-text HUD, Web Audio SFX. Built purely on the public Lite API:\n// character controllers, physics raycasts, navmesh crowds, thin instances, text layers.\n\nimport HavokPhysics from \"@babylonjs/havok\";\nimport {\n    addAgent,\n    agentGoto,\n    addToScene,\n    createBox,\n    createCapsule,\n    createDefaultTextData,\n    createEngine,\n    createFreeCamera,\n    createHavokWorld,\n    createHemisphericLight,\n    createNavigationPluginAsync,\n    createNavCrowd,\n    createNavMesh,\n    createPhysicsBody,\n    createPhysicsCharacterController,\n    createPhysicsShape,\n    createSceneContext,\n    createStandardMaterial,\n    createTextLayer,\n    createTextRenderer,\n    createTransformNode,\n    findRandomPointAroundCircle,\n    getAgentPosition,\n    getAgentVelocity,\n    loadFont,\n    mat4Compose,\n    onBeforeRender,\n    onPhysicsAfterStep,\n    physicsRaycast,\n    raycast,\n    registerScene,\n    registerTextRenderer,\n    removePhysicsBody,\n    setPhysicsBodyLinearVelocity,\n    setPhysicsBodyMass,\n    setPhysicsBodyShape,\n    setPhysicsShapeMaterial,\n    setThinInstances,\n    startEngine,\n    updateDefaultTextData,\n    updateNavCrowd,\n    CharacterSupportedState,\n    PhysicsMotionType,\n    PhysicsShapeType,\n} from \"babylon-lite\";\nimport type { PhysicsBody, PhysicsCharacterController, Vec3 } from \"babylon-lite\";\nimport { ARENA_SIZE, TERRAIN_LAYER, createFpsTerrain, destroyTerrainTile, terrainHeightAt, tileFromPoint } from \"./fps-terrain.js\";\nimport { createFpsAudio } from \"./fps-audio.js\";\nimport { createFpsInput } from \"./fps-input.js\";\n\nconst PHYSICS_FPS = 60;\nconst GRAVITY = 9.8;\nconst EYE_HEIGHT = 0.7; // above the capsule center (near the head)\nconst MUZZLE_OFFSET = 0.8; // ray origin in front of the eye, outside the player capsule\nconst CAP_HEIGHT = 1.8;\nconst CAP_RADIUS = 0.5;\nconst MAX_SPEED = 10;\nconst GROUND_ACCEL = 60;\nconst AIR_ACCEL = 18;\nconst JUMP_SPEED = 7;\nconst SLIDE_FRICTION = 1.5; // per-second horizontal decay while grounded with no input\nconst MOUSE_SENS = 0.002;\nconst FIRE_INTERVAL = 0.15;\nconst RAY_RANGE = 100;\nconst BOT_COUNT = 4;\nconst BOT_SPEED = 8;\nconst BOT_RANGE = 40;\nconst DEBRIS_COUNT = 32;\nconst DEBRIS_LIFE = 8; // seconds\nconst SPAWN = { x: 0, z: -40 };\n\ninterface Bot {\n    cc: PhysicsCharacterController;\n    agentIndex: number;\n    hp: number;\n    dead: boolean;\n    respawnAt: number;\n    nextRetarget: number;\n    nextShot: number;\n    velY: number;\n    heading: number;\n}\n\ninterface Debris {\n    body: PhysicsBody | null;\n    alive: boolean;\n    expiresAt: number;\n}\n\n/** Ray (origin + normalized dir, clamped to RAY_RANGE) vs a vertical capsule. Returns distance or null. */\nfunction rayVsCapsule(o: Vec3, d: Vec3, center: Vec3, halfH: number, r: number): number | null {\n    const ax = center.x;\n    const ay = center.y - halfH; // bottom cap center\n    const az = center.z;\n    const hh = halfH * 2;\n    const wx = o.x - ax;\n    const wy = o.y - ay;\n    const wz = o.z - az;\n    const b = d.y * hh;\n    const c = d.x * wx + d.y * wy + d.z * wz;\n    const e = hh * wy;\n    const det = hh * hh - b * b;\n    let best: number | null = null;\n    // Cylindrical band (axis between the two caps).\n    if (det > 1e-8) {\n        const t = (b * e - c * hh * hh) / det;\n        const u = (e - b * c) / det;\n        if (t >= 0 && t <= RAY_RANGE && u >= 0 && u <= 1) {\n            const px = o.x + d.x * t - ax;\n            const py = o.y + d.y * t - (ay + hh * u);\n            const pz = o.z + d.z * t - az;\n            if (px * px + py * py + pz * pz <= r * r) {\n                best = t;\n            }\n        }\n    }\n    // End caps, treated as spheres.\n    const cap = (cy: number): number | null => {\n        const qx = o.x - ax;\n        const qy = o.y - cy;\n        const qz = o.z - az;\n        const t = -(d.x * qx + d.y * qy + d.z * qz);\n        if (t < 0 || t > RAY_RANGE) {\n            return null;\n        }\n        const px = o.x + d.x * t - ax;\n        const py = o.y + d.y * t - cy;\n        const pz = o.z + d.z * t - az;\n        if (px * px + py * py + pz * pz <= r * r) {\n            return t;\n        }\n        return null;\n    };\n    const tb = cap(ay);\n    if (tb !== null && (best === null || tb < best)) {\n        best = tb;\n    }\n    const tt = cap(ay + hh);\n    if (tt !== null && (best === null || tt < best)) {\n        best = tt;\n    }\n    return best;\n}\n\nasync function main(): Promise<void> {\n    const __initStart = performance.now();\n    const canvas = document.getElementById(\"renderCanvas\") as HTMLCanvasElement;\n    const engine = await createEngine(canvas);\n    const scene = createSceneContext(engine);\n    scene.fixedDeltaMs = 1000 / PHYSICS_FPS;\n    scene.clearColor = { r: 0.04, g: 0.06, b: 0.09, a: 1 };\n\n    // Camera — driven per frame from the player's eye + yaw/pitch.\n    const cam = createFreeCamera({ x: SPAWN.x, y: 5, z: SPAWN.z }, { x: 0, y: 0, z: 0 });\n    cam.nearPlane = 0.1;\n    cam.farPlane = 500;\n    cam.fov = 1.1;\n    scene.camera = cam;\n\n    const light = createHemisphericLight([0, 1, 0]);\n    light.intensity = 0.7;\n    addToScene(scene, light);\n\n    // Physics world (Havok V2 wasm served from the lab root).\n    const hknp = await HavokPhysics({ locateFile: () => \"/HavokPhysics.wasm\" });\n    const world = createHavokWorld(scene, hknp, { x: 0, y: -GRAVITY, z: 0 });\n\n    // Destructible terrain: one dense grid mesh + a static box per tile.\n    const terrain = createFpsTerrain(engine, world);\n    const terrainMat = createStandardMaterial();\n    terrainMat.diffuseColor = [0.42, 0.48, 0.4];\n    terrainMat.specularColor = [0.05, 0.05, 0.05];\n    terrain.mesh.material = terrainMat;\n    addToScene(scene, terrain.mesh);\n\n    // Player — character controller with Quake-style slide (low dynamic friction).\n    const player = createPhysicsCharacterController(world, { x: SPAWN.x, y: terrainHeightAt(terrain, SPAWN.x, SPAWN.z) + CAP_HEIGHT / 2 + 0.1, z: SPAWN.z }, { capsuleHeight: CAP_HEIGHT, capsuleRadius: CAP_RADIUS });\n    player.staticFriction = 0;\n    player.dynamicFriction = 0.1;\n\n    // Navigation — navmesh from the terrain mesh; bots are NavCrowd agents driving controllers.\n    const nav = await createNavigationPluginAsync({ locateFile: () => \"/recast-navigation.wasm\" });\n    createNavMesh(nav, [terrain.mesh], {\n        cs: 0.5,\n        ch: 0.5,\n        walkableSlopeAngle: 45,\n        walkableHeight: 1,\n        walkableClimb: 1,\n        walkableRadius: 0.5,\n        maxEdgeLen: 12,\n        maxSimplificationError: 1.3,\n        minRegionArea: 8,\n        mergeRegionArea: 20,\n        maxVertsPerPoly: 6,\n        detailSampleDist: 6,\n        detailSampleMaxError: 1,\n    });\n    const crowd = createNavCrowd(nav, BOT_COUNT, 0.5);\n\n    // Bot display — one capsule mesh rendered as thin instances.\n    const botMesh = createCapsule(engine, { height: CAP_HEIGHT, radius: CAP_RADIUS, tessellation: 12 });\n    const botMat = createStandardMaterial();\n    botMat.diffuseColor = [0.9, 0.4, 0.2];\n    botMat.specularColor = [0.1, 0.05, 0.05];\n    botMesh.material = botMat;\n    addToScene(scene, botMesh);\n    const botMatrices = new Float32Array(BOT_COUNT * 16);\n    setThinInstances(botMesh, botMatrices, BOT_COUNT);\n\n    const bots: Bot[] = [];\n    const botSpawns = [\n        { x: -30, z: 30 },\n        { x: 30, z: 30 },\n        { x: -30, z: -30 },\n        { x: 30, z: -30 },\n    ];\n    for (let i = 0; i < BOT_COUNT; i++) {\n        const s = botSpawns[i]!;\n        const p = findRandomPointAroundCircle(nav, { x: s.x, y: 0, z: s.z }, 8);\n        const cc = createPhysicsCharacterController(world, { x: p.x, y: p.y + CAP_HEIGHT / 2, z: p.z }, { capsuleHeight: CAP_HEIGHT, capsuleRadius: CAP_RADIUS });\n        cc.staticFriction = 0;\n        cc.dynamicFriction = 0.1;\n        const agentIndex = addAgent(crowd, p, {\n            radius: 0.5,\n            height: CAP_HEIGHT,\n            maxAcceleration: 20,\n            maxSpeed: BOT_SPEED,\n            collisionQueryRange: 4,\n            pathOptimizationRange: 0,\n            separationWeight: 1,\n        });\n        bots.push({ cc, agentIndex, hp: 100, dead: false, respawnAt: 0, nextRetarget: 0, nextShot: 1 + i * 0.3, velY: 0, heading: 0 });\n    }\n\n    // Debris — dynamic box bodies rendered as thin instances (ring buffer).\n    const debrisMesh = createBox(engine, 0.6);\n    const debrisMat = createStandardMaterial();\n    debrisMat.diffuseColor = [0.55, 0.5, 0.45];\n    debrisMat.specularColor = [0.05, 0.05, 0.05];\n    debrisMesh.material = debrisMat;\n    addToScene(scene, debrisMesh);\n    const debrisMatrices = new Float32Array(DEBRIS_COUNT * 16);\n    setThinInstances(debrisMesh, debrisMatrices, DEBRIS_COUNT);\n    const debris: Debris[] = [];\n    for (let i = 0; i < DEBRIS_COUNT; i++) {\n        debris.push({ body: null, alive: false, expiresAt: 0 });\n    }\n    let debrisNext = 0;\n\n    // HUD — screen-space text layers composited over the 3D frame (clear: false).\n    const font = await loadFont(\"/fonts/Inter.ttf\");\n    const hudData = createDefaultTextData(font, 28, \"HP 100   KILLS 0   TILES 0\", [1, 1, 1, 1], { maxWidth: 1200, align: \"left\" });\n    const hudLayer = createTextLayer(hudData, { positionPx: { x: 24, y: 24 }, scale: 1, rotationRad: 0, opacity: 1 });\n    const crossData = createDefaultTextData(font, 20, \"+\", [1, 1, 1, 1], {});\n    const crossLayer = createTextLayer(crossData, { positionPx: { x: window.innerWidth / 2 - 8, y: window.innerHeight / 2 - 10 }, scale: 1, rotationRad: 0, opacity: 0.9 });\n    const tr = createTextRenderer(engine, { layers: [hudLayer, crossLayer], clear: false });\n\n    // Input + audio (DOM side).\n    const input = createFpsInput(canvas);\n    const audio = createFpsAudio();\n    input.onLockChange((locked) => {\n        if (locked) {\n            audio.unlock();\n        }\n    });\n\n    // ─── Game state ──────────────────────────────────────────────────\n    let gameTime = 0;\n    let yaw = 0;\n    let pitch = 0;\n    let playerHp = 100;\n    let kills = 0;\n    let invulnerableUntil = 3;\n    let lastShot = -1;\n    const playerVel: Vec3 = { x: 0, y: 0, z: 0 };\n    let lastHudText = \"\";\n\n    const eyePos = (): Vec3 => {\n        const p = player.getPosition();\n        return { x: p.x, y: p.y + EYE_HEIGHT, z: p.z };\n    };\n    const forwardDir = (): Vec3 => {\n        const cp = Math.cos(pitch);\n        return { x: Math.sin(yaw) * cp, y: Math.sin(pitch), z: Math.cos(yaw) * cp };\n    };\n\n    const respawnPlayer = (): void => {\n        player.setPosition({ x: SPAWN.x, y: terrainHeightAt(terrain, SPAWN.x, SPAWN.z) + CAP_HEIGHT / 2 + 0.1, z: SPAWN.z });\n        playerVel.x = 0;\n        playerVel.y = 0;\n        playerVel.z = 0;\n        playerHp = 100;\n        invulnerableUntil = gameTime + 3;\n    };\n\n    const damagePlayer = (amount: number): void => {\n        if (gameTime < invulnerableUntil) {\n            return;\n        }\n        playerHp -= amount;\n        audio.damage();\n        if (playerHp <= 0) {\n            respawnPlayer();\n        }\n    };\n\n    const respawnBot = (bot: Bot): void => {\n        const p = findRandomPointAroundCircle(nav, { x: 0, y: 0, z: 0 }, ARENA_SIZE / 3);\n        bot.cc.setPosition({ x: p.x, y: p.y + CAP_HEIGHT / 2, z: p.z });\n        bot.hp = 100;\n        bot.dead = false;\n        bot.velY = 0;\n        bot.nextRetarget = gameTime;\n        bot.nextShot = gameTime + 1.5;\n    };\n\n    const damageBot = (bot: Bot, amount: number): void => {\n        if (bot.dead) {\n            return;\n        }\n        bot.hp -= amount;\n        if (bot.hp <= 0) {\n            bot.dead = true;\n            bot.respawnAt = gameTime + 3;\n            kills++;\n        }\n    };\n\n    const spawnDebris = (x: number, y: number, z: number): void => {\n        const slot = debris[debrisNext]!;\n        debrisNext = (debrisNext + 1) % DEBRIS_COUNT;\n        if (slot.alive && slot.body) {\n            removePhysicsBody(world, slot.body);\n        }\n        const node = createTransformNode(\"fpsDebris\", x, y, z);\n        const body = createPhysicsBody(world, node, PhysicsMotionType.DYNAMIC);\n        const shape = createPhysicsShape(world, { type: PhysicsShapeType.BOX, parameters: { extents: { x: 0.3, y: 0.3, z: 0.3 } } });\n        setPhysicsBodyShape(world, body, shape);\n        setPhysicsBodyMass(world, body, 1);\n        setPhysicsShapeMaterial(world, shape, 0.3, 0.2);\n        setPhysicsBodyLinearVelocity(world, body, { x: (Math.random() - 0.5) * 4, y: 3 + Math.random() * 3, z: (Math.random() - 0.5) * 4 });\n        slot.body = body;\n        slot.alive = true;\n        slot.expiresAt = gameTime + DEBRIS_LIFE;\n    };\n\n    const tryFire = (): void => {\n        if (gameTime - lastShot < FIRE_INTERVAL) {\n            return;\n        }\n        lastShot = gameTime;\n        audio.gunshot();\n        const eye = eyePos();\n        const fwd = forwardDir();\n        // Cast from a muzzle point in front of the eye so the ray never starts inside\n        // the player's own capsule (the controller's shape can't be filter-masked).\n        const from: Vec3 = { x: eye.x + fwd.x * MUZZLE_OFFSET, y: eye.y + fwd.y * MUZZLE_OFFSET, z: eye.z + fwd.z * MUZZLE_OFFSET };\n        const to: Vec3 = { x: from.x + fwd.x * RAY_RANGE, y: from.y + fwd.y * RAY_RANGE, z: from.z + fwd.z * RAY_RANGE };\n\n        const terr = physicsRaycast(world, from, to, { membership: TERRAIN_LAYER });\n        let bestDist = Infinity;\n        let hitBot: Bot | null = null;\n        for (const bot of bots) {\n            if (bot.dead) {\n                continue;\n            }\n            const bp = bot.cc.getPosition();\n            const d = rayVsCapsule(from, fwd, bp, CAP_HEIGHT / 2, CAP_RADIUS);\n            if (d !== null && d < bestDist) {\n                bestDist = d;\n                hitBot = bot;\n            }\n        }\n\n        if (terr.hasHit && (!hitBot || terr.hitDistance < bestDist)) {\n            const tile = tileFromPoint(terrain, terr.hitPoint.x, terr.hitPoint.z);\n            if (tile) {\n                destroyTerrainTile(terrain, engine, world, nav, tile);\n                spawnDebris(terr.hitPoint.x, terr.hitPoint.y, terr.hitPoint.z);\n                audio.thud();\n            }\n        } else if (hitBot) {\n            damageBot(hitBot, 25);\n            audio.hit();\n        }\n    };\n    input.onFire(tryFire);\n\n    // ─── Physics-step logic (fixed 60 Hz) ────────────────────────────\n    onPhysicsAfterStep(world, (dt) => {\n        gameTime += dt;\n\n        // Player — Quake-style: slide on ground, weak air control, jump gated by support.\n        const support = player.checkSupport(dt, { x: 0, y: -1, z: 0 });\n        const grounded = support.supportedState === CharacterSupportedState.SUPPORTED || support.supportedState === CharacterSupportedState.SLIDING;\n        const cy = Math.cos(yaw);\n        const sy = Math.sin(yaw);\n        let ix = 0;\n        let iz = 0;\n        if (input.forward) {\n            ix += sy;\n            iz += cy;\n        }\n        if (input.back) {\n            ix -= sy;\n            iz -= cy;\n        }\n        if (input.right) {\n            ix += cy;\n            iz -= sy;\n        }\n        if (input.left) {\n            ix -= cy;\n            iz += sy;\n        }\n        const il = Math.hypot(ix, iz);\n        if (il > 0) {\n            ix /= il;\n            iz /= il;\n            playerVel.x += ix * (grounded ? GROUND_ACCEL : AIR_ACCEL) * dt;\n            playerVel.z += iz * (grounded ? GROUND_ACCEL : AIR_ACCEL) * dt;\n        }\n        if (input.jump && grounded) {\n            playerVel.y = JUMP_SPEED;\n        }\n        playerVel.y -= GRAVITY * dt;\n        if (playerVel.y < -30) {\n            playerVel.y = -30;\n        }\n        if (grounded && il === 0) {\n            const damp = Math.max(0, 1 - SLIDE_FRICTION * dt);\n            playerVel.x *= damp;\n            playerVel.z *= damp;\n        }\n        const hs = Math.hypot(playerVel.x, playerVel.z);\n        if (hs > MAX_SPEED) {\n            const s = MAX_SPEED / hs;\n            playerVel.x *= s;\n            playerVel.z *= s;\n        }\n        const preY = player.getPosition().y;\n        player.moveWithCollisions({ x: playerVel.x * dt, y: playerVel.y * dt, z: playerVel.z * dt });\n        const postY = player.getPosition().y;\n        if (playerVel.y < 0 && preY - postY < Math.abs(playerVel.y * dt) * 0.5) {\n            playerVel.y = 0; // floor contact — stop accumulating fall speed\n        }\n        const pp = player.getPosition();\n        if (pp.y < -20) {\n            respawnPlayer();\n        }\n\n        // Bots — NavCrowd steering + controller collisions.\n        updateNavCrowd(crowd, dt);\n        for (let i = 0; i < bots.length; i++) {\n            const bot = bots[i]!;\n            if (bot.dead) {\n                if (gameTime >= bot.respawnAt) {\n                    respawnBot(bot);\n                }\n                continue;\n            }\n            const bp = bot.cc.getPosition();\n            const pp2 = player.getPosition();\n            const dist = Math.hypot(pp2.x - bp.x, pp2.z - bp.z);\n            if (gameTime >= bot.nextRetarget) {\n                bot.nextRetarget = gameTime + 2 + Math.random() * 2;\n                const los = raycast(nav, { x: bp.x, y: bp.y - CAP_HEIGHT / 2, z: bp.z }, { x: pp2.x, y: pp2.y - CAP_HEIGHT / 2, z: pp2.z });\n                if (dist < BOT_RANGE && !los.hit) {\n                    agentGoto(crowd, bot.agentIndex, pp2);\n                } else {\n                    agentGoto(crowd, bot.agentIndex, findRandomPointAroundCircle(nav, bp, 20));\n                }\n            }\n            // Keep the nav agent glued to the controller (collisions cause drift).\n            const ap = getAgentPosition(crowd, bot.agentIndex);\n            if (Math.hypot(ap.x - bp.x, ap.z - bp.z) > 4) {\n                agentGoto(crowd, bot.agentIndex, bp);\n            }\n            const av = getAgentVelocity(crowd, bot.agentIndex);\n            if (av.x !== 0 || av.z !== 0) {\n                bot.heading = Math.atan2(av.x, av.z);\n            }\n            bot.velY -= GRAVITY * dt;\n            if (bot.velY < -30) {\n                bot.velY = -30;\n            }\n            const bPreY = bot.cc.getPosition().y;\n            bot.cc.moveWithCollisions({ x: av.x * dt, y: bot.velY * dt, z: av.z * dt });\n            const bPostY = bot.cc.getPosition().y;\n            if (bot.velY < 0 && bPreY - bPostY < Math.abs(bot.velY * dt) * 0.5) {\n                bot.velY = 0;\n            }\n            if (bot.cc.getPosition().y < -20) {\n                respawnBot(bot);\n                continue;\n            }\n            // Bot shooting — LOS-gated, distance-based accuracy.\n            if (gameTime >= bot.nextShot) {\n                bot.nextShot = gameTime + 1.2;\n                const los = raycast(nav, { x: bp.x, y: bp.y - CAP_HEIGHT / 2, z: bp.z }, { x: pp2.x, y: pp2.y - CAP_HEIGHT / 2, z: pp2.z });\n                if (dist < BOT_RANGE && !los.hit) {\n                    const accuracy = Math.max(0.15, 1 - dist / 50);\n                    if (Math.random() < accuracy) {\n                        damagePlayer(10);\n                    }\n                }\n            }\n        }\n\n        // Debris expiry.\n        for (const d of debris) {\n            if (d.alive && d.body && gameTime >= d.expiresAt) {\n                removePhysicsBody(world, d.body);\n                d.alive = false;\n            }\n        }\n    });\n\n    // ─── Render-frame logic (visual only) ────────────────────────────\n    onBeforeRender(scene, () => {\n        // Mouse look (applied once per frame from accumulated DOM deltas).\n        const delta = input.consumeLookDelta();\n        yaw -= delta.dx * MOUSE_SENS;\n        pitch -= delta.dy * MOUSE_SENS;\n        if (pitch > 1.5) {\n            pitch = 1.5;\n        }\n        if (pitch < -1.5) {\n            pitch = -1.5;\n        }\n        const eye = eyePos();\n        const fwd = forwardDir();\n        cam.position.set(eye.x, eye.y, eye.z);\n        cam.target.set(eye.x + fwd.x * 10, eye.y + fwd.y * 10, eye.z + fwd.z * 10);\n\n        // Bot display matrices.\n        for (let i = 0; i < bots.length; i++) {\n            const bot = bots[i]!;\n            const m = botMatrices.subarray(i * 16, i * 16 + 16);\n            if (bot.dead) {\n                m.fill(0);\n                m[15] = 1;\n            } else {\n                const p = bot.cc.getPosition();\n                const hm = mat4Compose(p.x, p.y, p.z, 0, Math.sin(bot.heading / 2), 0, Math.cos(bot.heading / 2), 1, 1, 1);\n                m.set(hm);\n            }\n        }\n        setThinInstances(botMesh, botMatrices, BOT_COUNT);\n\n        // Debris display matrices (node transform tracks the physics body).\n        for (let i = 0; i < debris.length; i++) {\n            const d = debris[i]!;\n            const m = debrisMatrices.subarray(i * 16, i * 16 + 16);\n            if (!d.alive || !d.body) {\n                m.fill(0);\n                m[15] = 1;\n                continue;\n            }\n            const n = d.body.node;\n            const q = n.rotationQuaternion;\n            const hm = mat4Compose(n.position.x, n.position.y, n.position.z, q.x, q.y, q.z, q.w, 1, 1, 1);\n            m.set(hm);\n        }\n        setThinInstances(debrisMesh, debrisMatrices, DEBRIS_COUNT);\n\n        // HUD text (only when the string changes).\n        const hudText = `HP ${Math.max(0, Math.round(playerHp))}   KILLS ${kills}   TILES ${terrain.destroyedCount}`;\n        if (hudText !== lastHudText) {\n            lastHudText = hudText;\n            updateDefaultTextData(hudData, hudText);\n        }\n    });\n\n    await registerScene(scene);\n    registerTextRenderer(tr);\n    await startEngine(engine);\n    canvas.dataset.initMs = String(Math.round(performance.now() - __initStart));\n    canvas.dataset.ready = \"true\";\n}\n\nmain().catch((err) => {\n    const canvas = document.getElementById(\"renderCanvas\") as HTMLCanvasElement | null;\n    if (canvas) {\n        canvas.dataset.error = err instanceof Error ? err.message : String(err);\n    }\n    console.error(err);\n});","t":5528118,"turn":9}
