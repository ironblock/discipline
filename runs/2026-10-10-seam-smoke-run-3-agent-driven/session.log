{"kind":"delta","request":5141,"seq":6657,"t":964791,"tool_call":{"arguments":"{\"content\": \"\\\"\\\"\\\"Markdown link checker.\\n\\nScans Markdown files for internal links and verifies that the targets\\nexist. Standard library only; no third-party dependencies.\\n\\nSupported link forms\\n--------------------\\n- ``[text](path/to/file.md)``      relative file links\\n- ``[text](dir/file.md#anchor)``   anchor checked against ATX headings\\n- ``[text](https://.../foo.md)``   http/https checked only with\\n  ``--check-remote``; skipped by default\\n- Image links ``![alt](img.png)``  checked as file targets\\n- Autolinks ``<file.md>``         checked as file targets\\n\\nMissing targets are reported as ``MISSING``; existing targets whose\\nanchor cannot be found are reported as ``NOANCHOR``.\\n\\nUsage\\n-----\\n    python linkcheck.py [FILES ...] [OPTIONS]\\n\\nWith no FILES, the current directory is scanned recursively for\\n``*.md`` files (skipping ``.git``, ``node_modules``, ``vendor``).\\n\\nExamples\\n--------\\n    python linkcheck.py                      # all *.md in this tree\\n    python linkcheck.py README.md docs/      # specific files/dirs\\n    python linkcheck.py --check-remote       # also verify http/https\\n    python linkcheck.py --allow-missing      # missing targets exit 0\\n\\nOptions\\n-------\\n    --check-remote    Also verify http/https links (HEAD request)\\n    --allow-missing   Report missing targets but exit 0\\n    --base-dir DIR    Resolve relative links against DIR (default:\\n                      the directory of each file)\\n    --verbose         One line per link checked, not just failures\\n\\nExit codes\\n----------\\n    0  all links OK (or only warnings, with --allow-missing)\\n    1  one or more missing targets / failed remote checks\\n    2  usage error (bad arguments, no files found)\\n\\\"\\\"\\\"\\n\\nimport argparse\\nimport os\\nimport re\\nimport sys\\n\\nSKIP_DIRS = {\\\".git\\\", \\\"node_modules\\\", \\\"vendor\\\"}\\n\\n# Inline link [text](target); also matches image links ![alt](target).\\nLINK_RE = re.compile(r\\\"\\\\[[^\\\\]]*\\\\]\\\\(([^()\\\\s]+)(?:\\\\s+\\\\\\\"[^\\\\\\\"]*\\\\\\\")?\\\\)\\\")\\nFENCE_RE = re.compile(r\\\"^\\\\s*(```|~~~)\\\")\\nSCHEME_RE = re.compile(r\\\"^[a-zA-Z][a-zA-Z0-9+.\\\\-]*:\\\")\\n\\n\\ndef find_md_files(paths):\\n    \\\"\\\"\\\"Collect .md files from the given files/dirs (recursively).\\n\\n    Returns a sorted list, or None if a path does not exist.\\n    \\\"\\\"\\\"\\n    if not paths:\\n        paths = [\\\".\\\"]\\n    files = []\\n    for p in paths:\\n        if os.path.isfile(p):\\n            files.append(p)\\n        elif os.path.isdir(p):\\n            for root, dirs, names in os.walk(p):\\n                dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)\\n                for name in sorted(names):\\n                    if name.lower().endswith(\\\".md\\\"):\\n                        files.append(os.path.join(root, name))\\n        else:\\n            print(f\\\"error: {p}: no such file or directory\\\", file=sys.stderr)\\n            return None\\n    return sorted(set(files))\\n\\n\\ndef extract_links(text):\\n    \\\"\\\"\\\"Yield (line_number, target) for inline links, skipping code fences.\\\"\\\"\\\"\\n    in_fence = False\\n    for lineno, line in enumerate(text.splitlines(), 1):\\n        if FENCE_RE.match(line):\\n            in_fence = not in_fence\\n            continue\\n        if in_fence:\\n            continue\\n        for m in LINK_RE.finditer(line):\\n            yield lineno, m.group(1)\\n\\n\\ndef check_file(path, base_dir):\\n    \\\"\\\"\\\"Check one file.\\n\\n    Returns a list of (line_number, target, ok) for local links,\\n    or None if the file cannot be read.\\n    \\\"\\\"\\\"\\n    try:\\n        with open(path, encoding=\\\"utf-8\\\") as f:\\n            text = f.read()\\n    except OSError as e:\\n        print(f\\\"error: {path}: {e}\\\", file=sys.stderr)\\n        return None\\n\\n    base = base_dir or os.path.dirname(path)\\n    results = []\\n    for lineno, target in extract_links(text):\\n        if SCHEME_RE.match(target):\\n            continue  # remote/mailto: not checked in this step\\n        path_part = target.split(\\\"#\\\", 1)[0]\\n        if not path_part:\\n            continue  # pure in-page anchor\\n        ok = os.path.exists(os.path.join(base, path_part))\\n        results.append((lineno, target, ok))\\n    return results\\n\\n\\ndef main(argv=None):\\n    parser = argparse.ArgumentParser(\\n        prog=\\\"linkcheck\\\", description=\\\"Check local links in Markdown files.\\\"\\n    )\\n    parser.add_argument(\\\"files\\\", nargs=\\\"*\\\", help=\\\"Markdown files or directories\\\")\\n    parser.add_argument(\\\"--base-dir\\\", help=\\\"resolve relative links against DIR\\\")\\n    parser.add_argument(\\\"--allow-missing\\\", action=\\\"store_true\\\",\\n                        help=\\\"report missing targets but exit 0\\\")\\n    parser.add_argument(\\\"--check-remote\\\", action=\\\"store_true\\\",\\n                        help=\\\"verify http/https links (reserved for a later step)\\\")\\n    parser.add_argument(\\\"--verbose\\\", action=\\\"store_true\\\",\\n                        help=\\\"print a line for every link checked\\\")\\n    args = parser.parse_args(argv)\\n\\n    if args.check_remote:\\n        print(\\\"warning: --check-remote is not implemented yet; \\\"\\n              \\\"remote links are skipped\\\", file=sys.stderr)\\n\\n    files = find_md_files(args.files)\\n    if files is None:\\n        return 2\\n    if not files:\\n        print(\\\"error: no .md files found\\\", file=sys.stderr)\\n        return 2\\n\\n    broken = []\\n    for path in files:\\n        results = check_file(path, args.base_dir)\\n        if results is None:\\n            return 2\\n        for lineno, target, ok in results:\\n            if ok:\\n                if args.verbose:\\n                    print(f\\\"{path}:{lineno}: {target} (ok)\\\")\\n            else:\\n                broken.append((path, lineno, target))\\n\\n    for path, lineno, target in broken:\\n        print(f\\\"{path}:{lineno}: {target}\\\")\\n    return 1 if broken and not args.allow_missing else 0\\n\\n\\ndef heading_slug(text):\\n    \\\"\\\"\\\"Turn a heading into a GitHub-style anchor slug.\\n\\n    Example: \\\"Hello, World!\\\" -> \\\"hello-world\\\".\\n    \\\"\\\"\\\"\\n    slug = text.strip().lower()\\n    slug = re.sub(r\\\"[^\\\\w\\\\s-]\\\", \\\"\\\", slug)\\n    slug = re.sub(r\\\"\\\\s+\\\", \\\"-\\\", slug)\\n    return slug\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\", \"path\": \"linkcheck.py\"}","id":"call_69aee689bc0749b59f220132","index":0,"name":"write"}}
