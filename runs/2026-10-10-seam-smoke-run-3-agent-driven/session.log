numerate(text.splitlines(), 1):\\n        if FENCE_RE.match(line):\\n            in_fence = not in_fence\\n            continue\\n        if in_fence:\\n            continue\\n        if REF_DEF_RE.match(line):\\n            continue\\n        for m in LINK_RE.finditer(line):\\n            yield lineno, m.group(1)\\n        for m in REF_LINK_RE.finditer(line):\\n            label = m.group(2) if m.group(2) else m.group(1)\\n            target = ref_defs.get(normalize_label(label))\\n            if target is not None:\\n                yield lineno, target\"}","id":"call_65aca8a9b67e4ad393800158","index":0,"name":"edit"}}
