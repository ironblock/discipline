#!/usr/bin/env bash
# A BSD `sed` for the difference that matters: how it reads `-i`.
#
# The `bsd` check (scripts/check-bsd-sed.sh, #75) puts this first on PATH and
# runs every injection under it, so the one portable spelling of an in-place
# edit, `edit_in_place`, is proven portable by execution. It used to be a
# manual tool whose header claimed that proof before anything ran it (#70).
#
# The difference: GNU sed takes `-i`'s optional suffix attached to the flag
# (`-i.bak`), and BSD sed takes it as the NEXT ARGUMENT (`-i .bak`, or `-i ''`
# for none). So GNU's `sed -i 's/a/b/' f` means, to BSD, suffix `s/a/b/` and
# script `f` -- and the error that comes back is about the script, which is
# why it reads as nonsense and why twenty-eight injections were inert on a Mac
# while CI was green (#50).
#
# Options are read the way BSD's getopt reads them, which is the whole model:
#   * a cluster is read flag by flag; `-e` and `-f` take the rest of the
#     cluster, or the next argument, as their argument, and `-i`/`-I` take it
#     as the suffix;
#   * the first operand ends the options -- BSD does not permute, so a `-i`
#     after the script or a file is an operand, never a flag;
#   * there are no long options: `--in-place`, in any spelling, is refused.
# The real sed is then handed the options and, after `--`, the operands, so
# GNU's permutation never reads a later `-i` either. An in-place edit is made
# here, BSD's way: each file through the real sed into a temporary, then over
# the file, with a backup when the suffix is not empty.
#
# Everything else is the real sed's. This is not an implementation of BSD sed
# and does not pretend to be: it reproduces how BSD reads an in-place edit,
# which is what a shim is for.
real=/usr/bin/sed
[ -x "$real" ] || real=/bin/sed

options=()
scripted=0
inplace=0
suffix=""
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --*) echo "sed: illegal option -- ${1#--}" >&2; exit 1 ;;
    -?*) ;;
    *) break ;;
  esac
  cluster="${1#-}"
  shift
  while [ -n "$cluster" ]; do
    flag="${cluster:0:1}"
    cluster="${cluster:1}"
    case "$flag" in
      e|f|i|I)
        if [ -n "$cluster" ]; then
          argument="$cluster"
        elif [ $# -gt 0 ]; then
          argument="$1"
          shift
        else
          echo "sed: option requires an argument -- $flag" >&2
          exit 1
        fi
        cluster=""
        case "$flag" in
          e|f) options+=("-$flag" "$argument"); scripted=1 ;;
          *) inplace=1; suffix="$argument" ;;
        esac
        ;;
      *) options+=("-$flag") ;;
    esac
  done
done

if [ "$inplace" = 0 ]; then
  exec "$real" "${options[@]}" -- "$@"
fi

if [ "$scripted" = 0 ]; then
  if [ $# -eq 0 ]; then
    echo "sed: no script" >&2
    exit 1
  fi
  options+=(-e "$1")
  shift
fi
if [ $# -eq 0 ]; then
  echo "sed: -I or -i may not be used with stdin" >&2
  exit 1
fi
for file in "$@"; do
  [ -z "$suffix" ] || cp -p -- "$file" "${file}${suffix}" || exit 1
  temporary="${file}.bsd-sed.$$"
  if "$real" "${options[@]}" -- "$file" > "$temporary"; then
    mv -- "$temporary" "$file" || exit 1
  else
    rm -f -- "$temporary"
    exit 1
  fi
done
