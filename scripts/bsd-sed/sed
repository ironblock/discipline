#!/bin/sh
# A BSD `sed` for the one difference that matters.
#
# THIS IS A MANUAL TOOL. Nothing in the gate runs it: no check, no CI step, no
# seeded fault. It proves nothing on its own, and the claim it used to carry
# -- that portability here is PROVEN BY EXECUTION -- was not true and has been
# taken out. What holds the portability claim today is the STRUCTURAL rule in
# scripts/check-injections.py: an injection body may not invoke `sed` in
# command position at all, so `edit_in_place` is the one spelling, and one
# definition is a thing that can be made portable.
#
# Wiring this shim so the injections actually RUN under it -- green if
# portable, exit 2 if a declared requirement is missing -- adds a check to the
# gate, which means an owner row, CI wiring and a seeded fault of its own.
# Ruled 2026-09-11 (#70) to land as its own item rather than as a review fix:
# that item is #75. The file stays because it is the mechanism that item
# needs; deleting it would delete the future proof along with the false claim.
#
# By hand, until then:
#
#   PATH="$PWD/scripts/bsd-sed:$PATH" ./verify.sh --only injections
#
# The difference: GNU sed takes `-i`'s optional suffix attached to the flag
# (`-i.bak`), and BSD sed takes it as the NEXT ARGUMENT (`-i .bak`, or `-i ''`
# for none). So GNU's `sed -i 's/a/b/' f` means, to BSD, suffix `s/a/b/` and
# script `f` -- and the error that comes back is about the script, which is
# why it reads as nonsense and why twenty-eight injections were inert on a Mac
# while CI was green (#50).
#
# Everything else is delegated to the real sed. This is not an implementation
# of BSD sed and does not pretend to be: it reproduces the one incompatibility
# the gate tripped over, which is what a shim is for.
real=/usr/bin/sed
[ -x "$real" ] || real=/bin/sed

if [ "$1" = "-i" ]; then
  shift
  # The suffix, BSD-style.
  [ $# -gt 0 ] && shift
  # Whatever is left, the first of it is the script. With no files after it,
  # read /dev/null rather than the terminal: a shim that hangs is worse than
  # the incompatibility it is demonstrating.
  if [ $# -eq 0 ]; then
    echo "sed: no script" >&2
    exit 1
  fi
  script="$1"
  shift
  if [ $# -eq 0 ]; then
    exec "$real" "$script" < /dev/null
  fi
  exec "$real" "$script" "$@"
fi

exec "$real" "$@"
