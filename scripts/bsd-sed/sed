#!/bin/sh
# A BSD `sed` for the difference that matters: how it reads `-i`.
#
# The `bsd` check (scripts/check-bsd-sed.sh, #75) puts this first on PATH and
# runs every injection under it, so the one portable spelling of an in-place
# edit, `edit_in_place`, is proven portable by execution. It used to be a
# manual tool whose header claimed that proof before anything ran it (#70).
#
# The difference: GNU sed takes `-i`'s optional suffix attached to the flag
# (`-i.bak`), and BSD sed takes it as the NEXT ARGUMENT (`-i .bak`, or `-i ''`
# for none). So GNU's `sed -i 's/a/b/' f` means, to BSD, suffix `s/a/b/` and
# script `f` -- and the error that comes back is about the script, which is
# why it reads as nonsense and why twenty-eight injections were inert on a Mac
# while CI was green (#50). Modelled the way BSD's getopt reads it: `i` in ANY
# option cluster (`-i`, `-s -i`, `-Ei`) takes the rest of the cluster, or the
# next argument, as its suffix. BSD sed has no long options either, so
# `--in-place` (in any spelling) is refused as BSD refuses it.
#
# Everything else is delegated to the real sed. This is not an implementation
# of BSD sed and does not pretend to be: it reproduces the incompatibilities
# in how an edit is made in place, which is what a shim is for.
real=/usr/bin/sed
[ -x "$real" ] || real=/bin/sed

inplace=0
options=""
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    --*) echo "sed: illegal option -- ${1#--}" >&2; exit 1 ;;
    -?*)
      cluster="${1#-}"
      shift
      case "$cluster" in
        *i*)
          inplace=1
          before="${cluster%%i*}"
          [ -n "$before" ] && options="$options -$before"
          # The suffix: the rest of the cluster, else the next argument.
          [ -z "${cluster#*i}" ] && [ $# -gt 0 ] && shift
          ;;
        *) options="$options -$cluster" ;;
      esac
      ;;
    *) break ;;
  esac
done

if [ "$inplace" = 1 ]; then
  # Whatever is left, the first of it is the script. With no files after it,
  # read /dev/null rather than the terminal: a shim that hangs is worse than
  # the incompatibility it is demonstrating.
  if [ $# -eq 0 ]; then
    echo "sed: no script" >&2
    exit 1
  fi
  script="$1"
  shift
  if [ $# -eq 0 ]; then
    # shellcheck disable=SC2086
    exec "$real" $options "$script" < /dev/null
  fi
  # shellcheck disable=SC2086
  exec "$real" $options "$script" "$@"
fi

# shellcheck disable=SC2086
exec "$real" $options "$@"
