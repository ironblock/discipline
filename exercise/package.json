{
  "name": "exercise",
  "version": "0.0.0",
  "private": true,
  "description": "The Storybook catalog for the reference harness: the record's atoms, rows and sequences, and two ledgers of what the record cannot yet carry.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gen": "node scripts/gen-fixtures.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:red": "node scripts/verify-red.mjs",
    "verify": "pnpm gen:drive --check && pnpm gen --check && pnpm typecheck && pnpm lint && pnpm test && pnpm check:fixtures && pnpm check:red",
    "gen:drive": "node scripts/drive-fixture.mjs"
  },
  "dependencies": {
    "@ariakit/react": "0.4.40",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "eslint": "10.11.0",
    "eslint-plugin-storybook": "10.6.0",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
